    "All data remains unchanged.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All data remains unchanged."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सारा डेटा जैसा है वैसा ही रहेगा।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಎಲ್ಲಾ ಡೇಟಾ ಬದಲಾಗದೆ ಉಳಿಯುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എല്ലാ ഡാറ്റയും മാറ്റമില്ലാതെ തുടരും."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அனைத்துத் தரவும் மாற்றமின்றி இருக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మొత్తం డేటా మారకుండా ఉంటుంది."
          }
        }
      }
    },
    "All the details you need to know.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All the details you need to know."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वह सब जो आपको जानना चाहिए।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ತಿಳಿಯಬೇಕಾದ ಎಲ್ಲಾ ವಿವರಗಳು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ അറിയേണ്ട എല്ലാ വിവരങ്ങളും."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் அறிய வேண்டிய அனைத்து விவரங்களும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు తెలుసుకోవాల్సిన అన్ని వివరాలు."
          }
        }
      }
    },
    "Allow access to your photos": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow access to your photos"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी फ़ोटो तक पहुँच की अनुमति दें"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಫೋಟೋಗಳಿಗೆ ಪ್ರವೇಶ ನೀಡಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ഫോട്ടോകൾ ആക്‌സസ് ചെയ്യാൻ അനുവദിക്കുക"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் புகைப்படங்களுக்கான அணுகலை அனுமதிக்கவும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ ఫోటోలకు యాక్సెస్ అనుమతించండి"
          }
        }
      }
    },
    "Allow microphone access in Settings to search by voice.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow microphone access in Settings to search by voice."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आवाज़ से खोजने के लिए सेटिंग्स में माइक्रोफ़ोन की अनुमति दें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಧ್ವನಿಯ ಮೂಲಕ ಹುಡುಕಲು ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಮೈಕ್ರೊಫೋನ್ ಪ್ರವೇಶ ನೀಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ശബ്ദത്തിലൂടെ തിരയാൻ ക്രമീകരണങ്ങളിൽ മൈക്രോഫോൺ ആക്‌സസ് അനുവദിക്കുക."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "குரல் மூலம் தேட, அமைப்புகளில் மைக்ரோஃபோன் அணுகலை அனுமதிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వాయిస్‌తో శోధించడానికి సెట్టింగ్స్‌లో మైక్రోఫోన్ యాక్సెస్‌ను అనుమతించండి."
          }
        }
      }
    },
    "Allow photo access in Settings to save this image to your device.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow photo access in Settings to save this image to your device."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस चित्र को अपने डिवाइस में सहेजने के लिए सेटिंग्स में फ़ोटो की अनुमति दें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಚಿತ್ರವನ್ನು ನಿಮ್ಮ ಸಾಧನಕ್ಕೆ ಉಳಿಸಲು ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಫೋಟೋ ಪ್ರವೇಶ ನೀಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ചിത്രം ഉപകരണത്തിൽ സേവ് ചെയ്യാൻ ക്രമീകരണങ്ങളിൽ ഫോട്ടോ ആക്‌സസ് അനുവദിക്കുക."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தப் படத்தை உங்கள் சாதனத்தில் சேமிக்க, அமைப்புகளில் புகைப்பட அணுகலை அனுமதிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ చిత్రాన్ని మీ పరికరంలో సేవ్ చేయడానికి సెట్టింగ్స్‌లో ఫోటో యాక్సెస్‌ను అనుమతించండి."
          }
        }
      }
    },
    "Already in your queue": {
