        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह गीत अब उपलब्ध नहीं है।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಹಾಡು ಇನ್ನು ಲಭ್ಯವಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ഗാനം ഇനി ലഭ്യമല്ല."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தப் பாடல் இனி கிடைக்காது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ పాట ఇకపై అందుబాటులో లేదు."
          }
        }
      }
    },
    "This tip option isn't available right now. Please try again later.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This tip option isn't available right now. Please try again later."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह टिप विकल्प अभी उपलब्ध नहीं है। कृपया बाद में पुनः प्रयास करें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಟಿಪ್ ಆಯ್ಕೆ ಈಗ ಲಭ್ಯವಿಲ್ಲ. ದಯವಿಟ್ಟು ನಂತರ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ടിപ്പ് ഓപ്ഷൻ ഇപ്പോൾ ലഭ്യമല്ല. ദയവായി പിന്നീട് ശ്രമിക്കുക."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த அன்பளிப்பு விருப்பம் இப்போது கிடைக்கவில்லை. பிறகு மீண்டும் முயற்சிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ టిప్ ఎంపిక ప్రస్తుతం అందుబాటులో లేదు. దయచేసి తర్వాత మళ్లీ ప్రయత్నించండి."
          }
        }
      }
    },
