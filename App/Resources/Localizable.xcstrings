          "stringUnit": {
            "state": "translated",
            "value": "Tip could not be confirmed"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टिप की पुष्टि नहीं हो सकी"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "టిప్ నిర్ధారించబడలేదు"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "டிப் உறுதிசெய்யப்படவில்லை"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಟಿಪ್ ದೃಢೀಕರಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ"
          }
        },
        "ml": {
