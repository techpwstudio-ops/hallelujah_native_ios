    "app.update.available.action": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपडेट करें"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅಪ್‌ಡೇಟ್"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അപ്ഡേറ്റ് ചെയ്യുക"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "புதுப்பி"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అప్‌డేట్"
          }
        }
      }
    },
    "app.update.available.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A new version of Hallelujah is available. Update now for the latest features and improvements."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hallelujah का नया संस्करण उपलब्ध है। नई सुविधाओं और सुधारों के लिए अभी अपडेट करें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Hallelujah ನ ಹೊಸ ಆವೃತ್ತಿ ಲಭ್ಯವಿದೆ. ಇತ್ತೀಚಿನ ವೈಶಿಷ್ಟ್ಯಗಳು ಮತ್ತು ಸುಧಾರಣೆಗಳಿಗಾಗಿ ಈಗಲೇ ಅಪ್‌ಡೇಟ್ ಮಾಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Hallelujah-ന്റെ പുതിയ പതിപ്പ് ലഭ്യമാണ്. ഏറ്റവും പുതിയ ഫീച്ചറുകൾക്കും മെച്ചപ്പെടുത്തലുകൾക്കുമായി ഇപ്പോൾ അപ്ഡേറ്റ് ചെയ്യുക."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Hallelujah-வின் புதிய பதிப்பு கிடைக்கிறது. சமீபத்திய அம்சங்கள் மற்றும் மேம்பாடுகளுக்கு இப்போதே புதுப்பிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Hallelujah కొత్త వెర్షన్ అందుబాటులో ఉంది. తాజా ఫీచర్లు, మెరుగుదలల కోసం ఇప్పుడే అప్‌డేట్ చేయండి."
          }
        }
      }
    },
    "app.update.available.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update Available"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपडेट उपलब्ध है"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅಪ್‌ಡೇಟ್ ಲಭ್ಯವಿದೆ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അപ്ഡേറ്റ് ലഭ്യമാണ്"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "புதுப்பிப்பு கிடைக்கிறது"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అప్‌డేట్ అందుబాటులో ఉంది"
          }
        }
      }
    },
