    "Session expired. Please sign in again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Session expired. Please sign in again."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सत्र समाप्त हो गया। कृपया फिर से साइन इन करें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸೆಷನ್ ಅವಧಿ ಮುಗಿದಿದೆ. ದಯವಿಟ್ಟು ಮತ್ತೆ ಸೈನ್ ಇನ್ ಮಾಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സെഷൻ കാലഹരണപ്പെട്ടു. ദയവായി വീണ്ടും സൈൻ ഇൻ ചെയ്യുക."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அமர்வு காலாவதியானது. மீண்டும் உள்நுழையவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సెషన్ ముగిసింది. దయచేసి మళ్లీ సైన్ ఇన్ చేయండి."
          }
        }
      }
    },
    "Settings": {
