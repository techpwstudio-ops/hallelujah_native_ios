    "Network is too slow to send audio — %lld frames dropped.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Network is too slow to send audio — %lld frames dropped."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑडियो भेजने के लिए नेटवर्क बहुत धीमा है — %lld फ़्रेम छूट गए।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆಡಿಯೋ ಕಳುಹಿಸಲು ನೆಟ್‌ವರ್ಕ್ ತುಂಬಾ ನಿಧಾನವಾಗಿದೆ — %lld ಫ್ರೇಮ್‌ಗಳು ಕೈಬಿಡಲಾಗಿದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഓഡിയോ അയയ്ക്കാൻ നെറ്റ്‌വർക്ക് വളരെ മന്ദഗതിയിലാണ് — %lld ഫ്രെയിമുകൾ നഷ്ടപ്പെട്ടു."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஆடியோ அனுப்ப நெட்வொர்க் மிகவும் மெதுவாக உள்ளது — %lld ஃபிரேம்கள் தவறவிடப்பட்டன."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆడియో పంపడానికి నెట్‌వర్క్ చాలా నెమ్మదిగా ఉంది — %lld ఫ్రేమ్‌లు పోయాయి."
          }
        }
      }
    },
