    "Choose the language used for menus, buttons and messages in the app.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the language used for menus, buttons and messages in the app."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप के मेनू, बटन और संदेशों के लिए भाषा चुनें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆ್ಯಪ್‌ನ ಮೆನುಗಳು, ಬಟನ್‌ಗಳು ಮತ್ತು ಸಂದೇಶಗಳಿಗೆ ಭಾಷೆಯನ್ನು ಆರಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആപ്പിലെ മെനുകൾ, ബട്ടണുകൾ, സന്ദേശങ്ങൾ എന്നിവയ്ക്കുള്ള ഭാഷ തിരഞ്ഞെടുക്കുക."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஆப்பில் உள்ள மெனுக்கள், பட்டன்கள் மற்றும் செய்திகளுக்கான மொழியைத் தேர்ந்தெடுக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "యాప్‌లోని మెనూలు, బటన్లు మరియు సందేశాల కోసం భాషను ఎంచుకోండి."
          }
        }
      }
    },
