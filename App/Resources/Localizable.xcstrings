    "Remove \"%@\" from your library?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove \"%@\" from your library?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" को अपनी लाइब्रेरी से हटाएँ?"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" ಅನ್ನು ನಿಮ್ಮ ಲೈಬ್ರರಿಯಿಂದ ತೆಗೆದುಹಾಕಬೇಕೇ?"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" നിങ്ങളുടെ ലൈബ്രറിയിൽ നിന്ന് നീക്കം ചെയ്യണോ?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\"-ஐ உங்கள் நூலகத்திலிருந்து நீக்கவா?"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\"ను మీ లైబ్రరీ నుండి తొలగించాలా?"
          }
        }
      }
    },
    "Remove %@ from Family Plan?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove %@ from Family Plan?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ को फ़ैमिली प्लान से हटाएँ?"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ಅವರನ್ನು ಕುಟುಂಬ ಯೋಜನೆಯಿಂದ ತೆಗೆದುಹಾಕಬೇಕೇ?"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ നെ ഫാമിലി പ്ലാനിൽ നിന്ന് നീക്കം ചെയ്യണോ?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ஐ குடும்பத் திட்டத்திலிருந்து நீக்கவா?"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ను ఫ్యామిలీ ప్లాన్ నుండి తొలగించాలా?"
          }
        }
      }
    },
