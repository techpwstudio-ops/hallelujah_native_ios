          "stringUnit": {
            "state": "translated",
            "value": "अपने पसंदीदा कलाकार चुनें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮಗಿಷ್ಟವಾದ ಕಲಾವಿದರನ್ನು ಆರಿಸಿ."
          }
