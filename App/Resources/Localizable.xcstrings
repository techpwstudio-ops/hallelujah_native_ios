    "Just start talking, or tap to interrupt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Just start talking, or tap to interrupt"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बस बोलना शुरू करें, या रोकने के लिए टैप करें"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮಾತನಾಡಲು ಪ್ರಾರಂಭಿಸಿ, ಅಥವಾ ತಡೆಯಲು ಟ್ಯಾಪ್ ಮಾಡಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സംസാരിച്ചു തുടങ്ങൂ, അല്ലെങ്കിൽ തടസ്സപ്പെടുത്താൻ ടാപ്പ് ചെയ്യൂ"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பேசத் தொடங்குங்கள், அல்லது குறுக்கிட தட்டுங்கள்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మాట్లాడటం ప్రారంభించండి, లేదా అంతరాయం కలిగించడానికి నొక్కండి"
          }
        }
      }
    },
    "Keep it short and easy to understand, and answer in %@.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
