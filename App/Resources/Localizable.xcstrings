        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुने हुए समय के बाद प्लेबैक रोक देता है"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆಯ್ಕೆಮಾಡಿದ ಸಮಯದ ನಂತರ ಪ್ಲೇಬ್ಯಾಕ್ ನಿಲ್ಲಿಸುತ್ತದೆ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "തിരഞ്ഞെടുത്ത സമയത്തിന് ശേഷം പ്ലേബാക്ക് നിർത്തും"
          }
        },
        "ta": {
          "stringUnit": {
