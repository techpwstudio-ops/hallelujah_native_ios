          }
        }
      }
    },
    "View your profile page.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View your profile page."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना प्रोफ़ाइल पेज देखें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಪ್ರೊಫೈಲ್ ಪುಟವನ್ನು ನೋಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ പ്രൊഫൈൽ പേജ് കാണുക."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் சுயவிவரப் பக்கத்தைக் காண்க."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ ప్రొఫైల్ పేజీని చూడండి."
          }
        }
      }
    },
    "Visit Site": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Visit Site"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साइट पर जाएँ"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸೈಟ್‌ಗೆ ಭೇಟಿ ನೀಡಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സൈറ്റ് സന്ദർശിക്കുക"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தளத்தைப் பார்வையிடு"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సైట్‌ను సందర్శించండి"
          }
        }
      }
    },
    "Voice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voice"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आवाज़"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಧ್ವನಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ശബ്ദം"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "குரல்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వాయిస్"
          }
        }
      }
    },
    "Voice search couldn't start. Please try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voice search couldn't start. Please try again."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वॉइस सर्च शुरू नहीं हो सकी। कृपया पुनः प्रयास करें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಧ್ವನಿ ಹುಡುಕಾಟ ಪ್ರಾರಂಭವಾಗಲಿಲ್ಲ. ದಯವಿಟ್ಟು ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വോയ്സ് സെർച്ച് ആരംഭിക്കാനായില്ല. ദയവായി വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "குரல் தேடலைத் தொடங்க முடியவில்லை. மீண்டும் முயற்சிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వాయిస్ శోధన ప్రారంభం కాలేదు. దయచేసి మళ్లీ ప్రయత్నించండి."
          }
        }
      }
    },
    "Voice search isn't available on this device": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voice search isn't available on this device"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस पर वॉइस सर्च उपलब्ध नहीं है"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಸಾಧನದಲ್ಲಿ ಧ್ವನಿ ಹುಡುಕಾಟ ಲಭ್ಯವಿಲ್ಲ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ഉപകരണത്തിൽ വോയ്സ് സെർച്ച് ലഭ്യമല്ല"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தச் சாதனத்தில் குரல் தேடல் கிடைக்கவில்லை"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ పరికరంలో వాయిస్ శోధన అందుబాటులో లేదు"
          }
        }
      }
    },
    "We couldn't reach the server. Please try again in a moment.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't reach the server. Please try again in a moment."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हम सर्वर तक नहीं पहुँच सके। कृपया कुछ देर बाद पुनः प्रयास करें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸರ್ವರ್ ತಲುಪಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ. ದಯವಿಟ್ಟು ಸ್ವಲ್ಪ ಸಮಯದ ನಂತರ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സെർവറിൽ എത്താനായില്ല. ദയവായി അൽപ്പസമയത്തിന് ശേഷം വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சர்வரை அடைய முடியவில்லை. சிறிது நேரம் கழித்து மீண்டும் முயற்சிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సర్వర్‌ను చేరుకోలేకపోయాం. దయచేసి కొద్దిసేపటి తర్వాత మళ్లీ ప్రయత్నించండి."
          }
        }
      }
    },
    "We've sent a 6-digit code to %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We've sent a 6-digit code to %@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हमने %@ पर 6 अंकों का कोड भेजा है"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ಗೆ 6-ಅಂಕಿಯ ಕೋಡ್ ಕಳುಹಿಸಲಾಗಿದೆ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഞങ്ങൾ %@ ലേക്ക് 6 അക്ക കോഡ് അയച്ചിട്ടുണ്ട്"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ க்கு 6 இலக்கக் குறியீட்டை அனுப்பியுள்ளோம்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మేము %@కు 6 అంకెల కోడ్‌ను పంపాం"
          }
        }
      }
    },
    "What do you want to listen to?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What do you want to listen to?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप क्या सुनना चाहते हैं?"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಏನನ್ನು ಆಲಿಸಲು ಬಯಸುತ್ತೀರಿ?"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾക്ക് എന്താണ് കേൾക്കേണ്ടത്?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் எதைக் கேட்க விரும்புகிறீர்கள்?"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఏమి వినాలనుకుంటున్నారు?"
          }
        }
      }
    },
    "What does the Bible say about the situation I’m facing?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What does the Bible say about the situation I’m facing?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैं जिस परिस्थिति का सामना कर रहा हूँ, उसके बारे में बाइबिल क्या कहती है?"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಾನು ಎದುರಿಸುತ್ತಿರುವ ಪರಿಸ್ಥಿತಿಯ ಬಗ್ಗೆ ಬೈಬಲ್ ಏನು ಹೇಳುತ್ತದೆ?"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഞാൻ നേരിടുന്ന സാഹചര്യത്തെക്കുറിച്ച് ബൈബിൾ എന്താണ് പറയുന്നത്?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நான் எதிர்கொள்ளும் சூழ்நிலையைப் பற்றி பைபிள் என்ன சொல்கிறது?"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నేను ఎదుర్కొంటున్న పరిస్థితి గురించి బైబిల్ ఏమి చెబుతోంది?"
          }
        }
      }
    },
    "What should I do when I feel lonely?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What should I do when I feel lonely?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब मैं अकेलापन महसूस करूँ तो मुझे क्या करना चाहिए?"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನನಗೆ ಒಂಟಿತನ ಅನಿಸಿದಾಗ ನಾನೇನು ಮಾಡಬೇಕು?"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എനിക്ക് ഏകാന്തത തോന്നുമ്പോൾ ഞാൻ എന്തു ചെയ്യണം?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தனிமையாக உணரும்போது நான் என்ன செய்ய வேண்டும்?"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఒంటరిగా అనిపించినప్పుడు నేను ఏమి చేయాలి?"
          }
        }
      }
    },
    "What's wrong with this ad?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What's wrong with this ad?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस विज्ञापन में क्या गलत है?"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಜಾಹೀರಾತಿನಲ್ಲಿ ಏನು ತಪ್ಪಿದೆ?"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ പരസ്യത്തിൽ എന്താണ് തെറ്റ്?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த விளம்பரத்தில் என்ன பிரச்சினை?"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ ప్రకటనలో తప్పేమిటి?"
          }
        }
      }
    },
    "Why do I feel anxious all the time?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why do I feel anxious all the time?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैं हर समय चिंतित क्यों महसूस करता हूँ?"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನನಗೆ ಯಾವಾಗಲೂ ಆತಂಕ ಏಕೆ ಆಗುತ್ತದೆ?"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എനിക്ക് എപ്പോഴും ഉത്കണ്ഠ തോന്നുന്നത് എന്തുകൊണ്ടാണ്?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நான் ஏன் எப்போதும் கவலையாக உணர்கிறேன்?"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నాకు ఎప్పుడూ ఆందోళనగా ఎందుకు అనిపిస్తుంది?"
          }
        }
      }
    },
    "Why does God feel silent?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why does God feel silent?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "परमेश्वर चुप क्यों लगते हैं?"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ದೇವರು ಮೌನವಾಗಿರುವಂತೆ ಏಕೆ ಅನಿಸುತ್ತದೆ?"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ദൈവം മൗനമായിരിക്കുന്നതായി തോന്നുന്നത് എന്തുകൊണ്ട്?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தேவன் ஏன் மௌனமாக இருப்பதுபோல் தோன்றுகிறது?"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "దేవుడు మౌనంగా ఉన్నట్లు ఎందుకు అనిపిస్తుంది?"
          }
        }
      }
    },
    "Why don't you want to see this?": {
