        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕ್ರೆಡಿಟ್‌ಗಳನ್ನು ನೋಡಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ക്രെഡിറ്റുകൾ കാണുക"
          }
        },
        "ta": {
          "stringUnit": {
