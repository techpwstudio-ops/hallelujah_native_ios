    "You can cancel this request shortly before deletion.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can cancel this request shortly before deletion."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप हटाए जाने से कुछ समय पहले तक इस अनुरोध को रद्द कर सकते हैं।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅಳಿಸುವಿಕೆಗೆ ಸ್ವಲ್ಪ ಮೊದಲು ನೀವು ಈ ವಿನಂತಿಯನ್ನು ರದ್ದುಮಾಡಬಹುದು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇല്ലാതാക്കുന്നതിന് തൊട്ടുമുമ്പ് വരെ ഈ അഭ്യർത്ഥന റദ്ദാക്കാം."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீக்கப்படுவதற்குச் சற்று முன்பு வரை இந்தக் கோரிக்கையை ரத்துசெய்யலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "తొలగింపునకు కొద్దిసేపటి ముందు వరకు ఈ అభ్యర్థనను రద్దు చేయవచ్చు."
          }
        }
      }
    },
    "You can cancel this request within the next %lld day by logging in.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can cancel this request within the next %lld day by logging in."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप अगले %lld दिन के भीतर लॉग इन करके इस अनुरोध को रद्द कर सकते हैं।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮುಂದಿನ %lld ದಿನದೊಳಗೆ ಲಾಗ್ ಇನ್ ಮಾಡಿ ಈ ವಿನಂತಿಯನ್ನು ರದ್ದುಮಾಡಬಹುದು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ലോഗിൻ ചെയ്ത് അടുത്ത %lld ദിവസത്തിനുള്ളിൽ ഈ അഭ്യർത്ഥന റദ്ദാക്കാം."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உள்நுழைந்து அடுத்த %lld நாளுக்குள் இந்தக் கோரிக்கையை ரத்துசெய்யலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "లాగిన్ అవ్వడం ద్వారా వచ్చే %lld రోజులో ఈ అభ్యర్థనను రద్దు చేయవచ్చు."
          }
        }
      }
    },
