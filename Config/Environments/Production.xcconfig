// Production.xcconfig — what ships to the App Store.

APP_ENVIRONMENT = production
APP_BUNDLE_ID_SUFFIX =
APP_DISPLAY_NAME = $(APP_NAME_BASE)

API_SCHEME = https
API_HOST = api.hallelujah.today
API_PORT =
API_BASE_PATH = /api

PROXY_SCHEME = https
PROXY_HOST = proxy.hallelujah.today
PROXY_PORT =
PROXY_BASE_PATH = /api

SOCKET_SCHEME = wss
SOCKET_HOST = ws.hallelujah.today
SOCKET_PORT =

WEBSITE_HOST = hallelujah.today
// Distinct from Development/Staging's CDN host: `SettingsService.cdnUrl`
// (`lib/services/settings_service.dart`) falls back to
// 'https://do5fy9mnhjqvi.cloudfront.net' when `EndPoints.isDev` is false —
// this xcconfig hierarchy previously copied the dev/staging host into
// Production by mistake (T15 finding).
CDN_HOST = do5fy9mnhjqvi.cloudfront.net

// Matches Flutter's `secret3` (lib/utils/security.dart): the real secret,
// injected via Config/Secrets.xcconfig or CI — never committed.
API_SECURE_HEADER = $(HALLELUJAH_API_SECRET)

// Matches Flutter's `secret1`/`secret2` (lib/utils/security.dart) — same
// injection story as API_SECURE_HEADER above.
API_OTP_SECRET_1 = $(HALLELUJAH_OTP_SECRET_1)
API_OTP_SECRET_2 = $(HALLELUJAH_OTP_SECRET_2)

// T23 — Firebase project + Google Sign-In client IDs, copied verbatim from
// the Flutter app's `ios/Firebase/Prod/GoogleService-Info.plist` and
// `lib/firebase_options.dart`'s `googleServerClientId` (non-dev branch).
// Not secrets — see Development.xcconfig's note on why these are plain
// values here rather than CI-injected like API_SECURE_HEADER above.
FIREBASE_API_KEY = AIzaSyCs2MpQw3OLTHsr4MhvgRR4djPJES9A20s
FIREBASE_APP_ID = 1:1052349300270:ios:5481caf2f2c4af1df329bf
FIREBASE_PROJECT_ID = hallelujah-49b89
FIREBASE_STORAGE_BUCKET = hallelujah-49b89.appspot.com
FIREBASE_GCM_SENDER_ID = 1052349300270
GOOGLE_IOS_CLIENT_ID = 1052349300270-dtchj51p80odgdrgsj750g8dght017tr.apps.googleusercontent.com
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.1052349300270-dtchj51p80odgdrgsj750g8dght017tr
GOOGLE_SERVER_CLIENT_ID = 1052349300270-9qa1mu60em885k78un8s8tm5adkh2u30.apps.googleusercontent.com

// C-preprocessor flag (1/0) — see Development.xcconfig for how it flows
// into Info.plist's NSAllowsArbitraryLoads.
ALLOWS_ARBITRARY_LOADS = 0

LOG_LEVEL = warning
ANALYTICS_ENABLED = YES
CRASH_REPORTING_ENABLED = YES

FEATURE_AI_ASSISTANT_ENABLED = YES
FEATURE_CARPLAY_ENABLED = YES
FEATURE_ADS_ENABLED = YES
FEATURE_ADS_PREVIEW_MODE = NO
FEATURE_DOWNLOADS_ENABLED = YES
FEATURE_TIP_BUTTON_ENABLED = NO
