    "Authentication with google failed, please try another method": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Authentication with google failed, please try another method"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Google से प्रमाणीकरण विफल रहा, कृपया कोई अन्य तरीका आज़माएँ"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Google ಮೂಲಕ ಪ್ರಮಾಣೀಕರಣ ವಿಫಲವಾಯಿತು, ದಯವಿಟ್ಟು ಬೇರೆ ವಿಧಾನ ಪ್ರಯತ್ನಿಸಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Google വഴിയുള്ള പ്രാമാണീകരണം പരാജയപ്പെട്ടു, മറ്റൊരു രീതി ശ്രമിക്കുക"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Google மூலம் அங்கீகரிக்க முடியவில்லை, வேறு முறையை முயற்சிக்கவும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Google ధృవీకరణ విఫలమైంది, దయచేసి మరో పద్ధతిని ప్రయత్నించండి"
          }
        }
      }
    },
