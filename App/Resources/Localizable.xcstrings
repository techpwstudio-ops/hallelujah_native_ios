    "Failed to load credits.\nPlease try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Failed to load credits.\nPlease try again."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "श्रेय लोड नहीं हो सका।\nकृपया पुनः प्रयास करें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕ್ರೆಡಿಟ್‌ಗಳನ್ನು ಲೋಡ್ ಮಾಡಲು ವಿಫಲವಾಯಿತು.\nದಯವಿಟ್ಟು ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ക്രെഡിറ്റുകൾ ലോഡ് ചെയ്യാനായില്ല.\nദയവായി വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
