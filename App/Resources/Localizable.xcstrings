        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "காரணத்தை உள்ளிட்டு மீண்டும் முயற்சிக்கவும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "దయచేసి కారణాన్ని నమోదు చేసి మళ్లీ ప్రయత్నించండి"
