        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "“Hey Siri, play [song] in Hallelujah” అని చెప్పండి"
          }
        }
      }
    },
    "carplay.search.hint.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask Siri to play audio"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri से ऑडियो चलाने को कहें"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆಡಿಯೋ ಪ್ಲೇ ಮಾಡಲು Siri ಗೆ ಹೇಳಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഓഡിയോ പ്ലേ ചെയ്യാൻ Siri-യോട് പറയൂ"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஆடியோவை இயக்க Siri-யிடம் கேளுங்கள்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆడియో ప్లే చేయమని Siriని అడగండి"
          }
        }
      }
    },
    "carplay.signInRequired": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in on your iPhone to use Hallelujah in the car"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कार में Hallelujah इस्तेमाल करने के लिए अपने iPhone पर साइन इन करें"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕಾರಿನಲ್ಲಿ Hallelujah ಬಳಸಲು ನಿಮ್ಮ iPhone ನಲ್ಲಿ ಸೈನ್ ಇನ್ ಮಾಡಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കാറിൽ Hallelujah ഉപയോഗിക്കാൻ നിങ്ങളുടെ iPhone-ൽ സൈൻ ഇൻ ചെയ്യുക"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "காரில் Hallelujah-ஐப் பயன்படுத்த உங்கள் iPhone-இல் உள்நுழையவும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కారులో Hallelujah ఉపయోగించడానికి మీ iPhoneలో సైన్ ఇన్ చేయండి"
          }
        }
      }
    },
