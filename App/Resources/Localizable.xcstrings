    "This purchase could not be verified by the App Store. Please try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This purchase could not be verified by the App Store. Please try again."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store इस खरीद को सत्यापित नहीं कर सका। कृपया पुनः प्रयास करें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಖರೀದಿಯನ್ನು App Store ಪರಿಶೀಲಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ. ದಯವಿಟ್ಟು ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ വാങ്ങൽ App Store-ന് സ്ഥിരീകരിക്കാനായില്ല. ദയവായി വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தக் கொள்முதலை App Store சரிபார்க்க முடியவில்லை. மீண்டும் முயற்சிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ కొనుగోలును App Store ధృవీకరించలేకపోయింది. దయచేసి మళ్లీ ప్రయత్నించండి."
          }
        }
      }
    },
    "This song is no longer available.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This song is no longer available."
