    "offline.banner.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to browse your downloads"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने डाउनलोड देखने के लिए टैप करें"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಡೌನ್‌ಲೋಡ್‌ಗಳನ್ನು ನೋಡಲು ಟ್ಯಾಪ್ ಮಾಡಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഡൗൺലോഡുകൾ ബ്രൗസ് ചെയ്യാൻ ടാപ്പ് ചെയ്യുക"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் பதிவிறக்கங்களை உலாவ தட்டுங்கள்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ డౌన్‌లోడ్‌లను చూడటానికి నొక్కండి"
          }
        }
      }
    },
