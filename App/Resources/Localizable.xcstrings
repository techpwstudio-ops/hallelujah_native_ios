    "Do you really want to delete this playlist? Once deleted, it can't be restored.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do you really want to delete this playlist? Once deleted, it can't be restored."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या आप वाकई यह प्लेलिस्ट हटाना चाहते हैं? हटाने के बाद इसे वापस नहीं लाया जा सकता।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಪ್ಲೇಲಿಸ್ಟ್ ಅನ್ನು ನಿಜವಾಗಿಯೂ ಅಳಿಸಲು ಬಯಸುವಿರಾ? ಅಳಿಸಿದ ನಂತರ ಅದನ್ನು ಮರಳಿ ಪಡೆಯಲು ಸಾಧ್ಯವಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ പ്ലേലിസ്റ്റ് ഇല്ലാതാക്കണമെന്ന് ഉറപ്പാണോ? ഇല്ലാതാക്കിയാൽ വീണ്ടെടുക്കാൻ കഴിയില്ല."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தப் பிளேலிஸ்ட்டை உண்மையிலேயே நீக்க வேண்டுமா? நீக்கிய பிறகு மீட்டெடுக்க முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ ప్లేలిస్ట్‌ను నిజంగా తొలగించాలనుకుంటున్నారా? తొలగించిన తర్వాత తిరిగి పొందలేరు."
          }
        }
      }
    },
    "Do you wish to cancel the invite?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do you wish to cancel the invite?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या आप निमंत्रण रद्द करना चाहते हैं?"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಆಹ್ವಾನವನ್ನು ರದ್ದುಮಾಡಲು ಬಯಸುವಿರಾ?"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ക്ഷണം റദ്ദാക്കണോ?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அழைப்பை ரத்துசெய்ய விரும்புகிறீர்களா?"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆహ్వానాన్ని రద్దు చేయాలనుకుంటున్నారా?"
          }
        }
      }
    },
