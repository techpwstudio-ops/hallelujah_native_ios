    "Share Premium with up to %lld family members.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share Premium with up to %lld family members."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Premium को %lld फ़ैमिली सदस्यों तक के साथ साझा करें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Premium ಅನ್ನು %lld ಕುಟುಂಬ ಸದಸ್ಯರವರೆಗೆ ಹಂಚಿಕೊಳ್ಳಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld കുടുംബാംഗങ്ങളുമായി വരെ Premium പങ്കിടാം."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Premium-ஐ %lld குடும்ப உறுப்பினர்கள் வரை பகிருங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Premiumను %lld మంది కుటుంబ సభ్యులతో షేర్ చేయండి."
          }
        }
      }
    },
