    "carplay.search.hint.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Say “Hey Siri, play [song] in Hallelujah”"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कहें “Hey Siri, play [song] in Hallelujah”"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "“Hey Siri, play [song] in Hallelujah” ಎಂದು ಹೇಳಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "“Hey Siri, play [song] in Hallelujah” എന്ന് പറയൂ"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "“Hey Siri, play [song] in Hallelujah” என்று சொல்லுங்கள்"
