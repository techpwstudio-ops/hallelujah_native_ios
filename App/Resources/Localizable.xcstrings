    "Find your favorite songs, artists or playlists": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find your favorite songs, artists or playlists"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने पसंदीदा गीत, कलाकार या प्लेलिस्ट खोजें"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಮೆಚ್ಚಿನ ಹಾಡುಗಳು, ಕಲಾವಿದರು ಅಥವಾ ಪ್ಲೇಲಿಸ್ಟ್‌ಗಳನ್ನು ಹುಡುಕಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ പ്രിയപ്പെട്ട ഗാനങ്ങൾ, കലാകാരന്മാർ, പ്ലേലിസ്റ്റുകൾ കണ്ടെത്തൂ"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்களுக்குப் பிடித்த பாடல்கள், கலைஞர்கள் அல்லது பிளேலிஸ்ட்களைக் கண்டறியுங்கள்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీకు ఇష్టమైన పాటలు, కళాకారులు లేదా ప్లేలిస్ట్‌లను కనుగొనండి"
          }
        }
      }
    },
