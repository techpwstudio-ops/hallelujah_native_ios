    "Couldn't save the image. Your verse is safe — try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't save the image. Your verse is safe — try again."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चित्र सहेजा नहीं जा सका। आपका वचन सुरक्षित है — पुनः प्रयास करें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಚಿತ್ರ ಉಳಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ. ನಿಮ್ಮ ವಚನ ಸುರಕ್ಷಿತವಾಗಿದೆ — ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ചിത്രം സേവ് ചെയ്യാനായില്ല. നിങ്ങളുടെ വചനം സുരക്ഷിതമാണ് — വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "படத்தைச் சேமிக்க முடியவில்லை. உங்கள் வசனம் பாதுகாப்பாக உள்ளது — மீண்டும் முயற்சிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చిత్రాన్ని సేవ్ చేయలేకపోయాం. మీ వచనం భద్రంగా ఉంది — మళ్లీ ప్రయత్నించండి."
          }
        }
      }
    },
    "Couldn't start a new conversation. Please try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't start a new conversation. Please try again."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नई बातचीत शुरू नहीं हो सकी। कृपया पुनः प्रयास करें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಹೊಸ ಸಂಭಾಷಣೆ ಪ್ರಾರಂಭಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ. ದಯವಿಟ್ಟು ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പുതിയ സംഭാഷണം ആരംഭിക്കാനായില്ല. ദയവായി വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "புதிய உரையாடலைத் தொடங்க முடியவில்லை. மீண்டும் முயற்சிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కొత్త సంభాషణను ప్రారంభించలేకపోయాం. దయచేసి మళ్లీ ప్రయత్నించండి."
          }
        }
      }
    },
