        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी फ़ीड खाली है"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಫೀಡ್ ಖಾಲಿಯಾಗಿದೆ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ഫീഡ് ശൂന്യമാണ്"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் ஃபீட் காலியாக உள்ளது"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ ఫీడ్ ఖాళీగా ఉంది"
          }
        }
      }
    },
    "Your list": {
      "extractionState": "manual",
      "localizations": {
