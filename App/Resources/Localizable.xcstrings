    "Check your connection and try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your connection and try again."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना कनेक्शन जाँचें और पुनः प्रयास करें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಸಂಪರ್ಕವನ್ನು ಪರಿಶೀಲಿಸಿ ಮತ್ತು ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
