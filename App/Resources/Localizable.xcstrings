    "Your music will continue after the break": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your music will continue after the break"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ब्रेक के बाद आपका संगीत जारी रहेगा"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ವಿರಾಮದ ನಂತರ ನಿಮ್ಮ ಸಂಗೀತ ಮುಂದುವರಿಯುತ್ತದೆ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇടവേളയ്ക്ക് ശേഷം നിങ്ങളുടെ സംഗീതം തുടരും"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இடைவேளைக்குப் பிறகு உங்கள் இசை தொடரும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "విరామం తర్వాత మీ సంగీతం కొనసాగుతుంది"
          }
        }
      }
    },
    "Your music will continue after this ad": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your music will continue after this ad"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस विज्ञापन के बाद आपका संगीत जारी रहेगा"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಜಾಹೀರಾತಿನ ನಂತರ ನಿಮ್ಮ ಸಂಗೀತ ಮುಂದುವರಿಯುತ್ತದೆ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ പരസ്യത്തിന് ശേഷം നിങ്ങളുടെ സംഗീതം തുടരും"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த விளம்பரத்திற்குப் பிறகு உங்கள் இசை தொடரும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ ప్రకటన తర్వాత మీ సంగీతం కొనసాగుతుంది"
          }
        }
      }
    },
    "Your session has expired. Please sign in again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your session has expired. Please sign in again."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका सत्र समाप्त हो गया है। कृपया फिर से साइन इन करें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಸೆಷನ್ ಅವಧಿ ಮುಗಿದಿದೆ. ದಯವಿಟ್ಟು ಮತ್ತೆ ಸೈನ್ ಇನ್ ಮಾಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ സെഷൻ കാലഹരണപ്പെട്ടു. ദയവായി വീണ്ടും സൈൻ ഇൻ ചെയ്യുക."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் அமர்வு காலாவதியானது. மீண்டும் உள்நுழையவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ సెషన్ ముగిసింది. దయచేసి మళ్లీ సైన్ ఇన్ చేయండి."
          }
        }
      }
    },
    "Yours and curated for you": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yours and curated for you"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी अपनी और आपके लिए चुनी हुई"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮದು ಮತ್ತು ನಿಮಗಾಗಿ ಆಯ್ದದ್ದು"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടേതും നിങ്ങൾക്കായി തിരഞ്ഞെടുത്തതും"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்களுடையவை மற்றும் உங்களுக்காகத் தேர்ந்தெடுக்கப்பட்டவை"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీవి మరియు మీ కోసం ఎంపిక చేసినవి"
          }
        }
      }
    },
