    "Apple sign-in did not complete. Please try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple sign-in did not complete. Please try again."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple साइन-इन पूरा नहीं हुआ। कृपया पुनः प्रयास करें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ಸೈನ್-ಇನ್ ಪೂರ್ಣಗೊಳ್ಳಲಿಲ್ಲ. ದಯವಿಟ್ಟು ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple സൈൻ-ഇൻ പൂർത്തിയായില്ല. ദയവായി വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple உள்நுழைவு முடிவடையவில்லை. மீண்டும் முயற்சிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple సైన్-ఇన్ పూర్తి కాలేదు. దయచేసి మళ్లీ ప్రయత్నించండి."
          }
        }
      }
    },
    "Apple sign-in failed. Please try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple sign-in failed. Please try again."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple साइन-इन विफल रहा। कृपया पुनः प्रयास करें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ಸೈನ್-ಇನ್ ವಿಫಲವಾಯಿತು. ದಯವಿಟ್ಟು ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple സൈൻ-ഇൻ പരാജയപ്പെട്ടു. ദയവായി വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple உள்நுழைவு தோல்வியடைந்தது. மீண்டும் முயற்சிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple సైన్-ఇన్ విఫలమైంది. దయచేసి మళ్లీ ప్రయత్నించండి."
          }
        }
      }
    },
    "Are you sure to go back?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure to go back?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या आप वाकई वापस जाना चाहते हैं?"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಖಂಡಿತವಾಗಿ ಹಿಂತಿರುಗಲು ಬಯಸುವಿರಾ?"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "തിരികെ പോകണമെന്ന് ഉറപ്പാണോ?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நிச்சயமாகப் பின்செல்ல வேண்டுமா?"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు వెనక్కి వెళ్లాలనుకుంటున్నారా?"
          }
        }
      }
    },
    "Are you sure to logout Hallelujah?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure to logout Hallelujah?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या आप वाकई Hallelujah से लॉग आउट करना चाहते हैं?"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಖಂಡಿತವಾಗಿ Hallelujah ನಿಂದ ಲಾಗ್‌ಔಟ್ ಆಗಲು ಬಯಸುವಿರಾ?"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Hallelujah-ൽ നിന്ന് ലോഗ്ഔട്ട് ചെയ്യണമെന്ന് ഉറപ്പാണോ?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Hallelujah-இலிருந்து வெளியேற நிச்சயமா?"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు Hallelujah నుండి లాగ్ అవుట్ అవ్వాలనుకుంటున్నారా?"
          }
        }
      }
    },
    "Are you sure you want to delete all data associated with your ID? This action cannot be undone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to delete all data associated with your ID? This action cannot be undone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या आप वाकई अपनी ID से जुड़ा सारा डेटा हटाना चाहते हैं? यह क्रिया पूर्ववत नहीं की जा सकती।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಐಡಿಗೆ ಸಂಬಂಧಿಸಿದ ಎಲ್ಲಾ ಡೇಟಾವನ್ನು ಅಳಿಸಲು ನೀವು ಖಚಿತವಾಗಿ ಬಯಸುವಿರಾ? ಈ ಕ್ರಿಯೆಯನ್ನು ರದ್ದುಗೊಳಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ഐഡിയുമായി ബന്ധപ്പെട്ട എല്ലാ ഡാറ്റയും ഇല്ലാതാക്കണമെന്ന് ഉറപ്പാണോ? ഈ പ്രവൃത്തി പഴയപടിയാക്കാൻ കഴിയില്ല."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் ID-உடன் தொடர்புடைய அனைத்துத் தரவையும் நீக்க நிச்சயமா? இதை மீட்டெடுக்க முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ ID తో అనుబంధించబడిన మొత్తం డేటాను తొలగించాలని ఖచ్చితంగా అనుకుంటున్నారా? ఈ చర్యను రద్దు చేయలేరు."
          }
        }
      }
    },
