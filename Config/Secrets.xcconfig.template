// Secrets.xcconfig.template
//
// Copy to Config/Secrets.xcconfig (gitignored) and fill in. Base.xcconfig
// pulls it in with `#include?`, so the file is optional — a fresh clone still
// builds and runs against the simulator without it.
//
//   cp Config/Secrets.xcconfig.template Config/Secrets.xcconfig
//
// Never commit real values. CI injects these as environment variables instead.

// Apple Developer team used for code signing.
HALLELUJAH_DEVELOPMENT_TEAM =

// Third-party keys. Read through AppConfiguration, never inline in Swift.
RAZORPAY_KEY_ID =
CLARITY_PROJECT_ID =
