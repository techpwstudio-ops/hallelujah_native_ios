    "Thanks for reporting. We'll take a look.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thanks for reporting. We'll take a look."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिपोर्ट करने के लिए धन्यवाद। हम इसे देखेंगे।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ವರದಿ ಮಾಡಿದ್ದಕ್ಕೆ ಧನ್ಯವಾದಗಳು. ನಾವು ಪರಿಶೀಲಿಸುತ್ತೇವೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "റിപ്പോർട്ട് ചെയ്തതിന് നന്ദി. ഞങ്ങൾ പരിശോധിക്കാം."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "புகாருக்கு நன்றி. நாங்கள் பார்க்கிறோம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నివేదించినందుకు ధన్యవాదాలు. మేము పరిశీలిస్తాం."
          }
        }
      }
    },
    "Thanks — we'll show you more like this": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thanks — we'll show you more like this"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "धन्यवाद — हम आपको इसी तरह का और दिखाएँगे"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಧನ್ಯವಾದಗಳು — ಇದೇ ರೀತಿಯವನ್ನು ಇನ್ನಷ್ಟು ತೋರಿಸುತ್ತೇವೆ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നന്ദി — ഇതുപോലുള്ളവ ഞങ്ങൾ കൂടുതൽ കാണിക്കാം"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நன்றி — இதுபோன்றவற்றை மேலும் காட்டுவோம்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ధన్యవాదాలు — ఇలాంటివి మరిన్ని చూపిస్తాం"
          }
        }
      }
    },
    "That email is already in use": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That email is already in use"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह ईमेल पहले से उपयोग में है"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆ ಇಮೇಲ್ ಈಗಾಗಲೇ ಬಳಕೆಯಲ್ಲಿದೆ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആ ഇമെയിൽ ഇതിനകം ഉപയോഗത്തിലാണ്"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அந்த மின்னஞ்சல் ஏற்கனவே பயன்பாட்டில் உள்ளது"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆ ఇమెయిల్ ఇప్పటికే వాడుకలో ఉంది"
          }
        }
      }
    },
    "That took too long. Please try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That took too long. Please try again."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसमें बहुत समय लग गया। कृपया पुनः प्रयास करें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇದಕ್ಕೆ ತುಂಬಾ ಸಮಯ ಹಿಡಿಯಿತು. ದಯವಿಟ್ಟು ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇതിന് വളരെയധികം സമയമെടുത്തു. ദയവായി വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அதிக நேரம் எடுத்தது. மீண்டும் முயற்சிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చాలా సమయం పట్టింది. దయచేసి మళ్లీ ప్రయత్నించండి."
          }
        }
      }
    },
    "The %@ Bible is already downloading.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The %@ Bible is already downloading."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ बाइबिल पहले से डाउनलोड हो रही है।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ಬೈಬಲ್ ಈಗಾಗಲೇ ಡೌನ್‌ಲೋಡ್ ಆಗುತ್ತಿದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ബൈബിൾ ഇതിനകം ഡൗൺലോഡ് ചെയ്യുന്നുണ്ട്."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ பைபிள் ஏற்கனவே பதிவிறக்கப்படுகிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ బైబిల్ ఇప్పటికే డౌన్‌లోడ్ అవుతోంది."
          }
        }
      }
    },
    "The %@ Bible is already saved on this device.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The %@ Bible is already saved on this device."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ बाइबिल इस डिवाइस पर पहले से सहेजी गई है।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ಬೈಬಲ್ ಈಗಾಗಲೇ ಈ ಸಾಧನದಲ್ಲಿ ಉಳಿಸಲಾಗಿದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ബൈബിൾ ഇതിനകം ഈ ഉപകരണത്തിൽ സേവ് ചെയ്തിട്ടുണ്ട്."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ பைபிள் ஏற்கனவே இந்தச் சாதனத்தில் சேமிக்கப்பட்டுள்ளது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ బైబిల్ ఇప్పటికే ఈ పరికరంలో సేవ్ చేయబడింది."
          }
        }
      }
    },
    "The code will expire in 10 minutes.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The code will expire in 10 minutes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोड 10 मिनट में समाप्त हो जाएगा।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕೋಡ್ 10 ನಿಮಿಷಗಳಲ್ಲಿ ಮುಕ್ತಾಯವಾಗುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കോഡ് 10 മിനിറ്റിനുള്ളിൽ കാലഹരണപ്പെടും."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "குறியீடு 10 நிமிடங்களில் காலாவதியாகும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కోడ్ 10 నిమిషాల్లో గడువు ముగుస్తుంది."
          }
        }
      }
    },
    "The request timed out. Please try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The request timed out. Please try again."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुरोध का समय समाप्त हो गया। कृपया पुनः प्रयास करें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ವಿನಂತಿಯ ಸಮಯ ಮೀರಿತು. ದಯವಿಟ್ಟು ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അഭ്യർത്ഥനയുടെ സമയപരിധി കഴിഞ്ഞു. ദയവായി വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கோரிக்கை நேரம் முடிந்தது. மீண்டும் முயற்சிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అభ్యర్థన సమయం ముగిసింది. దయచేసి మళ్లీ ప్రయత్నించండి."
          }
        }
      }
    },
    "Theme": {
      "extractionState": "manual",
      "localizations": {
