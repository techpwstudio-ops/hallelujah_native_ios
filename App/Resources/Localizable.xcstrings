    "There is issue from developer side, please contact to developer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is issue from developer side, please contact to developer"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डेवलपर की ओर से समस्या है, कृपया डेवलपर से संपर्क करें"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಡೆವಲಪರ್ ಕಡೆಯಿಂದ ಸಮಸ್ಯೆ ಇದೆ, ದಯವಿಟ್ಟು ಡೆವಲಪರ್ ಅವರನ್ನು ಸಂಪರ್ಕಿಸಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഡെവലപ്പറുടെ ഭാഗത്ത് പ്രശ്നമുണ്ട്, ദയവായി ഡെവലപ്പറെ ബന്ധപ്പെടുക"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "டெவலப்பர் பக்கத்தில் சிக்கல் உள்ளது, டெவலப்பரைத் தொடர்புகொள்ளவும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "డెవలపర్ వైపు సమస్య ఉంది, దయచేసి డెవలపర్‌ను సంప్రదించండి"
          }
        }
      }
    },
