    "Didn't catch that. Tap the mic and try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Didn't catch that. Tap the mic and try again."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समझ नहीं आया। माइक पर टैप करें और पुनः प्रयास करें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅರ್ಥವಾಗಲಿಲ್ಲ. ಮೈಕ್ ಟ್ಯಾಪ್ ಮಾಡಿ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മനസ്സിലായില്ല. മൈക്കിൽ ടാപ്പ് ചെയ്ത് വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "புரியவில்லை. மைக்கைத் தட்டி மீண்டும் முயற்சிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అర్థం కాలేదు. మైక్‌ను నొక్కి మళ్లీ ప్రయత్నించండి."
          }
        }
      }
    },
