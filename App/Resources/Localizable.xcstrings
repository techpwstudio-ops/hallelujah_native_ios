          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूरे बोल देखें"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪೂರ್ಣ ಸಾಹಿತ್ಯ ನೋಡಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മുഴുവൻ വരികളും കാണുക"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முழு பாடல் வரிகளைக் காண்க"
