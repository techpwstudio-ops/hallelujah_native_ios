    "To continue, type '%@' exactly in the field below.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To continue, type '%@' exactly in the field below."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जारी रखने के लिए, नीचे दिए फ़ील्ड में '%@' ठीक वैसा ही लिखें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮುಂದುವರಿಯಲು, ಕೆಳಗಿನ ಕ್ಷೇತ್ರದಲ್ಲಿ '%@' ಅನ್ನು ಅದೇ ರೀತಿ ಟೈಪ್ ಮಾಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "തുടരാൻ, താഴെയുള്ള ഫീൽഡിൽ '%@' കൃത്യമായി ടൈപ്പ് ചെയ്യുക."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தொடர, கீழே உள்ள புலத்தில் '%@' என்பதை அப்படியே தட்டச்சு செய்யவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కొనసాగించడానికి, కింది ఫీల్డ్‌లో '%@' అని ఖచ్చితంగా టైప్ చేయండి."
          }
        }
      }
    },
