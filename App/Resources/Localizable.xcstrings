          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಚಿಕ್ಕದಾಗಿ ಮತ್ತು ಸುಲಭವಾಗಿ ಅರ್ಥವಾಗುವಂತೆ %@ ಭಾಷೆಯಲ್ಲಿ ಉತ್ತರಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
