          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் முதல் குறிப்பைச் சேர்க்க ஒரு வசனத்தைத் தட்டுங்கள்"
          }
        },
        "te": {
