    "You can select up to %lld languages": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can select up to %lld languages"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप अधिकतम %lld भाषाएँ चुन सकते हैं"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಗರಿಷ್ಠ %lld ಭಾಷೆಗಳನ್ನು ಆಯ್ಕೆಮಾಡಬಹುದು"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പരമാവധി %lld ഭാഷകൾ തിരഞ്ഞെടുക്കാം"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld மொழிகள் வரை தேர்ந்தெடுக்கலாம்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు గరిష్టంగా %lld భాషలను ఎంచుకోవచ్చు"
          }
        }
      }
    },
    "You can select up to %lld languages. Remove one to add another.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can select up to %lld languages. Remove one to add another."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप अधिकतम %lld भाषाएँ चुन सकते हैं। नई जोड़ने के लिए एक हटाएँ।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಗರಿಷ್ಠ %lld ಭಾಷೆಗಳನ್ನು ಆಯ್ಕೆಮಾಡಬಹುದು. ಇನ್ನೊಂದನ್ನು ಸೇರಿಸಲು ಒಂದನ್ನು ತೆಗೆದುಹಾಕಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പരമാവധി %lld ഭാഷകൾ തിരഞ്ഞെടുക്കാം. മറ്റൊന്ന് ചേർക്കാൻ ഒന്ന് നീക്കം ചെയ്യുക."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld மொழிகள் வரை தேர்ந்தெடுக்கலாம். மற்றொன்றைச் சேர்க்க ஒன்றை நீக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు గరిష్టంగా %lld భాషలను ఎంచుకోవచ్చు. మరొకటి చేర్చడానికి ఒకదాన్ని తొలగించండి."
          }
        }
      }
    },
    "You don't have permission to do that.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You don't have permission to do that."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके पास ऐसा करने की अनुमति नहीं है।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅದನ್ನು ಮಾಡಲು ನಿಮಗೆ ಅನುಮತಿ ಇಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അത് ചെയ്യാൻ നിങ്ങൾക്ക് അനുമതിയില്ല."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அதைச் செய்ய உங்களுக்கு அனுமதி இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "దీన్ని చేయడానికి మీకు అనుమతి లేదు."
          }
        }
      }
    },
    "You need an internet connection to save the %@ Bible for offline reading.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You need an internet connection to save the %@ Bible for offline reading."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ बाइबिल को ऑफ़लाइन पढ़ने के लिए सहेजने हेतु इंटरनेट कनेक्शन चाहिए।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ಬೈಬಲ್ ಅನ್ನು ಆಫ್‌ಲೈನ್ ಓದಿಗೆ ಉಳಿಸಲು ನಿಮಗೆ ಇಂಟರ್ನೆಟ್ ಸಂಪರ್ಕ ಬೇಕು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ബൈബിൾ ഓഫ്‌ലൈൻ വായനയ്ക്കായി സേവ് ചെയ്യാൻ ഇന്റർനെറ്റ് കണക്ഷൻ ആവശ്യമാണ്."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ பைபிளை ஆஃப்லைனில் படிக்கச் சேமிக்க இணைய இணைப்பு தேவை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆఫ్‌లైన్ పఠనం కోసం %@ బైబిల్‌ను సేవ్ చేయడానికి ఇంటర్నెట్ కనెక్షన్ అవసరం."
          }
        }
      }
    },
    "You'll see less of this ad": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll see less of this ad"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप यह विज्ञापन कम देखेंगे"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಜಾಹೀರಾತು ಕಡಿಮೆ ಕಾಣಿಸುತ್ತದೆ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ പരസ്യം കുറച്ച് മാത്രമേ കാണിക്കൂ"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த விளம்பரம் குறைவாகவே காட்டப்படும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ ప్రకటన తక్కువగా కనిపిస్తుంది"
          }
        }
      }
    },
    "You're sending messages too quickly. Please slow down and try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're sending messages too quickly. Please slow down and try again."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप बहुत तेज़ संदेश भेज रहे हैं। कृपया धीमे करें और पुनः प्रयास करें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ತುಂಬಾ ವೇಗವಾಗಿ ಸಂದೇಶ ಕಳುಹಿಸುತ್ತಿದ್ದೀರಿ. ದಯವಿಟ್ಟು ನಿಧಾನಿಸಿ ಮತ್ತು ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ വളരെ വേഗത്തിൽ സന്ദേശങ്ങൾ അയയ്ക്കുന്നു. ദയവായി വേഗം കുറച്ച് വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் மிக வேகமாகச் செய்திகளை அனுப்புகிறீர்கள். சற்று மெதுவாக மீண்டும் முயற்சிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు సందేశాలను చాలా వేగంగా పంపుతున్నారు. దయచేసి నెమ్మదిగా మళ్లీ ప్రయత్నించండి."
          }
        }
      }
    },
    "You've reached the end": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've reached the end"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप अंत तक पहुँच गए हैं"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಕೊನೆಯನ್ನು ತಲುಪಿದ್ದೀರಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ അവസാനത്തിലെത്തി"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முடிவை அடைந்துவிட்டீர்கள்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు చివరికి చేరుకున్నారు"
          }
        }
      }
    },
    "Your Premium benefits will continue until %@.You can re-activate Premium anytime from the subscription page.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Premium benefits will continue until %@.You can re-activate Premium anytime from the subscription page."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके Premium लाभ %@ तक जारी रहेंगे। आप सदस्यता पेज से कभी भी Premium फिर से सक्रिय कर सकते हैं।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ Premium ಪ್ರಯೋಜನಗಳು %@ ವರೆಗೆ ಮುಂದುವರಿಯುತ್ತವೆ. ಚಂದಾದಾರಿಕೆ ಪುಟದಿಂದ ಯಾವಾಗ ಬೇಕಾದರೂ Premium ಅನ್ನು ಮರು ಸಕ್ರಿಯಗೊಳಿಸಬಹುದು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ Premium ആനുകൂല്യങ്ങൾ %@ വരെ തുടരും. സബ്സ്ക്രിപ്ഷൻ പേജിൽ നിന്ന് എപ്പോൾ വേണമെങ്കിലും Premium വീണ്ടും സജീവമാക്കാം."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் Premium பலன்கள் %@ வரை தொடரும். சந்தாப் பக்கத்திலிருந்து எப்போது வேண்டுமானாலும் Premium-ஐ மீண்டும் செயல்படுத்தலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ Premium ప్రయోజనాలు %@ వరకు కొనసాగుతాయి. సబ్‌స్క్రిప్షన్ పేజీ నుండి ఎప్పుడైనా Premiumను మళ్లీ యాక్టివేట్ చేయవచ్చు."
          }
        }
      }
    },
    "Your account is active again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account is active again."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका खाता फिर से सक्रिय है।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಖಾತೆ ಮತ್ತೆ ಸಕ್ರಿಯವಾಗಿದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ അക്കൗണ്ട് വീണ്ടും സജീവമായി."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் கணக்கு மீண்டும் செயலில் உள்ளது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ ఖాతా మళ్లీ యాక్టివ్‌గా ఉంది."
          }
        }
      }
    },
    "Your account is scheduled for deletion on %lld.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account is scheduled for deletion on %lld."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका खाता %lld को हटाया जाना निर्धारित है।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಖಾತೆಯನ್ನು %lld ರಂದು ಅಳಿಸಲು ನಿಗದಿಪಡಿಸಲಾಗಿದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ അക്കൗണ്ട് %lld ന് ഇല്ലാതാക്കാൻ ഷെഡ്യൂൾ ചെയ്തിരിക്കുന്നു."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் கணக்கு %lld அன்று நீக்கப்பட திட்டமிடப்பட்டுள்ளது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ ఖాతా %lld న తొలగింపునకు షెడ్యూల్ చేయబడింది."
          }
        }
      }
    },
    "Your account is scheduled for deletion very soon.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account is scheduled for deletion very soon."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका खाता जल्द ही हटाया जाएगा।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಖಾತೆಯನ್ನು ಬಹಳ ಬೇಗ ಅಳಿಸಲು ನಿಗದಿಪಡಿಸಲಾಗಿದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ അക്കൗണ്ട് ഉടൻ തന്നെ ഇല്ലാതാക്കാൻ ഷെഡ്യൂൾ ചെയ്തിരിക്കുന്നു."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் கணக்கு விரைவில் நீக்கப்பட திட்டமிடப்பட்டுள்ளது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ ఖాతా అతి త్వరలో తొలగింపునకు షెడ్యూల్ చేయబడింది."
          }
        }
      }
    },
    "Your data, your rights.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your data, your rights."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका डेटा, आपके अधिकार।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಡೇಟಾ, ನಿಮ್ಮ ಹಕ್ಕುಗಳು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ഡാറ്റ, നിങ്ങളുടെ അവകാശങ്ങൾ."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் தரவு, உங்கள் உரிமைகள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ డేటా, మీ హక్కులు."
          }
        }
      }
    },
    "Your device does not have device lock, please set and try again": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your device does not have device lock, please set and try again"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके डिवाइस में डिवाइस लॉक नहीं है, कृपया सेट करें और पुनः प्रयास करें"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಸಾಧನದಲ್ಲಿ ಸಾಧನ ಲಾಕ್ ಇಲ್ಲ, ದಯವಿಟ್ಟು ಹೊಂದಿಸಿ ಮತ್ತು ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ഉപകരണത്തിൽ ഡിവൈസ് ലോക്ക് ഇല്ല, സജ്ജീകരിച്ച് വീണ്ടും ശ്രമിക്കുക"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் சாதனத்தில் பூட்டு அமைக்கப்படவில்லை, அமைத்து மீண்டும் முயற்சிக்கவும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ పరికరంలో డివైస్ లాక్ లేదు, దయచేసి సెట్ చేసి మళ్లీ ప్రయత్నించండి"
          }
        }
      }
    },
