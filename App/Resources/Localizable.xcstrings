    "Every contribution helps artists continue creating music.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every contribution helps artists continue creating music."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर योगदान कलाकारों को संगीत रचते रहने में मदद करता है।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪ್ರತಿಯೊಂದು ಕೊಡುಗೆಯೂ ಕಲಾವಿದರು ಸಂಗೀತ ರಚನೆಯನ್ನು ಮುಂದುವರಿಸಲು ಸಹಾಯ ಮಾಡುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഓരോ സംഭാവനയും കലാകാരന്മാർക്ക് സംഗീതം തുടർന്നും സൃഷ്ടിക്കാൻ സഹായിക്കുന്നു."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒவ்வொரு பங்களிப்பும் கலைஞர்கள் இசையைத் தொடர்ந்து உருவாக்க உதவுகிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రతి సహకారం కళాకారులు సంగీతాన్ని సృష్టించడం కొనసాగించడానికి సహాయపడుతుంది."
          }
        }
      }
    },
