    "Type your comment here": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type your comment here"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी टिप्पणी यहाँ लिखें"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಕಾಮೆಂಟ್ ಇಲ್ಲಿ ಟೈಪ್ ಮಾಡಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ അഭിപ്രായം ഇവിടെ ടൈപ്പ് ചെയ്യുക"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் கருத்தை இங்கே தட்டச்சு செய்யவும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ వ్యాఖ్యను ఇక్కడ టైప్ చేయండి"
          }
        }
      }
    },
    "Unable to open this link. Please try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to open this link. Please try again."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह लिंक नहीं खुल सका। कृपया पुनः प्रयास करें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಲಿಂಕ್ ತೆರೆಯಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ. ದಯವಿಟ್ಟು ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ലിങ്ക് തുറക്കാനായില്ല. ദയവായി വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த இணைப்பைத் திறக்க முடியவில்லை. மீண்டும் முயற்சிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ లింక్‌ను తెరవలేకపోయాం. దయచేసి మళ్లీ ప్రయత్నించండి."
          }
        }
      }
    },
    "Unable to open this notification. Please try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to open this notification. Please try again."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह सूचना नहीं खुल सकी। कृपया पुनः प्रयास करें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಅಧಿಸೂಚನೆ ತೆರೆಯಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ. ದಯವಿಟ್ಟು ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ അറിയിപ്പ് തുറക്കാനായില്ല. ദയവായി വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த அறிவிப்பைத் திறக்க முடியவில்லை. மீண்டும் முயற்சிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ నోటిఫికేషన్‌ను తెరవలేకపోయాం. దయచేసి మళ్లీ ప్రయత్నించండి."
          }
        }
      }
    },
