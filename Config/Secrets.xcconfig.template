// Secrets.xcconfig.template
//
// Copy to Config/Secrets.xcconfig (gitignored) and fill in. Base.xcconfig
// pulls it in with `#include?`, so the file is optional — a fresh clone still
// builds and runs against the simulator without it.
//
//   cp Config/Secrets.xcconfig.template Config/Secrets.xcconfig
//
// Never commit real values. CI injects these as environment variables instead.

// Apple Developer team used for code signing.
HALLELUJAH_DEVELOPMENT_TEAM =

// Third-party keys. Read through AppConfiguration, never inline in Swift.
// (CLARITY_PROJECT_ID is not here: it is committed in Shared/Base.xcconfig.)
RAZORPAY_KEY_ID =

// Backend "secure" request header (Flutter's `secret3` in production — see
// lib/utils/security.dart). Development/Staging use a fixed non-secret value
// instead (Config/Environments/{Development,Staging}.xcconfig), so this is
// only needed for a Release build talking to Production.
HALLELUJAH_API_SECRET =

// Unified OTP endpoint body secrets (Flutter's `secret1`/`secret2` in
// production — see lib/utils/security.dart). Same Development/Staging
// fixed-value story as HALLELUJAH_API_SECRET above.
HALLELUJAH_OTP_SECRET_1 =
HALLELUJAH_OTP_SECRET_2 =
