    "Remove the %@ Bible from this device? You'll need to download it again to read it offline.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove the %@ Bible from this device? You'll need to download it again to read it offline."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ बाइबिल को इस डिवाइस से हटाएँ? ऑफ़लाइन पढ़ने के लिए आपको इसे फिर से डाउनलोड करना होगा।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ಬೈಬಲ್ ಅನ್ನು ಈ ಸಾಧನದಿಂದ ತೆಗೆದುಹಾಕಬೇಕೇ? ಆಫ್‌ಲೈನ್‌ನಲ್ಲಿ ಓದಲು ನೀವು ಅದನ್ನು ಮತ್ತೆ ಡೌನ್‌ಲೋಡ್ ಮಾಡಬೇಕಾಗುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ബൈബിൾ ഈ ഉപകരണത്തിൽ നിന്ന് നീക്കം ചെയ്യണോ? ഓഫ്‌ലൈനായി വായിക്കാൻ ഇത് വീണ്ടും ഡൗൺലോഡ് ചെയ്യേണ്ടിവരും."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ பைபிளை இந்தச் சாதனத்திலிருந்து நீக்கவா? ஆஃப்லைனில் படிக்க மீண்டும் பதிவிறக்க வேண்டும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ బైబిల్‌ను ఈ పరికరం నుండి తొలగించాలా? ఆఫ్‌లైన్‌లో చదవడానికి దాన్ని మళ్లీ డౌన్‌లోడ్ చేయాలి."
          }
        }
      }
    },
    "Remove this from your library?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove this from your library?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे अपनी लाइब्रेरी से हटाएँ?"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇದನ್ನು ನಿಮ್ಮ ಲೈಬ್ರರಿಯಿಂದ ತೆಗೆದುಹಾಕಬೇಕೇ?"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇത് നിങ്ങളുടെ ലൈബ്രറിയിൽ നിന്ന് നീക്കം ചെയ്യണോ?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இதை உங்கள் நூலகத்திலிருந்து நீக்கவா?"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "దీన్ని మీ లైబ్రరీ నుండి తొలగించాలా?"
          }
        }
      }
    },
