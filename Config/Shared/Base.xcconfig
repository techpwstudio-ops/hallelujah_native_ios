// Base.xcconfig
// Settings shared by every target and every configuration.
//
// NOTE: `//` starts a comment in xcconfig files, so a full URL can never be
// written here. Hosts are stored scheme-less and composed in Swift by
// `AppConfiguration`. See Docs/CONFIGURATION.md.

// ── Platform ────────────────────────────────────────────────────────────────
SDKROOT = iphoneos
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
IPHONEOS_DEPLOYMENT_TARGET = 17.0
TARGETED_DEVICE_FAMILY = 1,2
// Mac runs the iPad build itself ("Designed for iPad", Apple silicon) rather
// than a Catalyst port: one binary, and CarPlay/Siri/App Check/IAP unchanged.
// The layout is width-driven (`AdaptiveLayout`), so a resizable Mac window is
// just another window width. Mac App Store availability is still switched on
// in App Store Connect (Pricing and Availability → iPhone and iPad Apps on
// Apple Silicon Macs); this setting adds the "My Mac (Designed for iPad)" run
// destination.
SUPPORTS_MACCATALYST = NO
SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD = YES

// ── Swift ───────────────────────────────────────────────────────────────────
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_UPCOMING_FEATURE_EXISTENTIAL_ANY = YES
SWIFT_EMIT_LOC_STRINGS = YES

// ── Identity ────────────────────────────────────────────────────────────────
// The single source of truth for who we are. Environments may append a
// bundle-id suffix; the home-screen name is the same in every environment.
APP_BUNDLE_ID_BASE = com.hallelujah.user
APP_NAME_BASE = Hallelujah
APP_DISPLAY_NAME = $(APP_NAME_BASE)
ORGANIZATION_NAME = Hallelujah

// ── Analytics ───────────────────────────────────────────────────────────────
// Microsoft Clarity project id, copied from the Flutter app (lib/main.dart).
// Not a secret — it ships inside every client build — so it is committed here
// rather than injected by CI.
CLARITY_PROJECT_ID = xmuqz9leqv

// ── Versioning ──────────────────────────────────────────────────────────────
// This app REPLACES the Flutter app (same bundle id), so the version must be
// above Flutter's last release (4.0.2, build 330) or the App Store / installs
// treat it as a downgrade. CI overrides CURRENT_PROJECT_VERSION only; this
// MARKETING_VERSION is the one place to edit before each App Store release
// (it must increase past whatever is live in App Store Connect).
MARKETING_VERSION = 4.0.4
CURRENT_PROJECT_VERSION = 335

// ── Signing ─────────────────────────────────────────────────────────────────
// DEVELOPMENT_TEAM is intentionally not committed. Set it in
// Config/Secrets.xcconfig (gitignored) or via the CI environment.
CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM = $(HALLELUJAH_DEVELOPMENT_TEAM)

// ── Build hygiene ───────────────────────────────────────────────────────────
ALWAYS_SEARCH_USER_PATHS = NO
CLANG_ENABLE_OBJC_ARC = YES
CLANG_ENABLE_MODULES = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
ENABLE_MODULE_VERIFIER = NO
DEAD_CODE_STRIPPING = YES
GCC_NO_COMMON_BLOCKS = YES
LOCALIZATION_PREFERS_STRING_CATALOGS = YES
ENABLE_HARDENED_RUNTIME = NO

// ── Warnings ────────────────────────────────────────────────────────────────
GCC_WARN_UNDECLARED_SELECTOR = YES
GCC_WARN_UNINITIALIZED_AUTOS = YES
GCC_WARN_UNUSED_FUNCTION = YES
GCC_WARN_UNUSED_VARIABLE = YES
CLANG_WARN_DOCUMENTATION_COMMENTS = YES
CLANG_WARN_UNREACHABLE_CODE = YES
CLANG_WARN_EMPTY_BODY = YES

// Developer-local overrides and credentials. Optional by design: a fresh
// clone builds for the simulator without it.
#include? "../Secrets.xcconfig"

// The binary/product name. Distinct from APP_DISPLAY_NAME, which is what the
// user sees on the home screen.
APP_PRODUCT_NAME = Hallelujah
