          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சுருக்கமாகவும் எளிதாகப் புரியும்படியும், %@ மொழியில் பதிலளிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep it short and easy to understand, and answer in %@."
          }
        }
      }
