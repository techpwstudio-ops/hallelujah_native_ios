    "Hidden for today. Toggle to show.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidden for today. Toggle to show."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज के लिए छिपा है। दिखाने के लिए टॉगल करें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇಂದಿಗೆ ಮರೆಮಾಡಲಾಗಿದೆ. ತೋರಿಸಲು ಟಾಗಲ್ ಮಾಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇന്നത്തേക്ക് മറച്ചിരിക്കുന്നു. കാണിക്കാൻ ടോഗിൾ ചെയ്യുക."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இன்றைக்கு மறைக்கப்பட்டது. காட்ட மாற்றவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ రోజుకు దాచబడింది. చూపడానికి టాగుల్ చేయండి."
          }
        }
      }
    },
