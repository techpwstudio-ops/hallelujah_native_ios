    "Too many requests. Please try again later.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many requests. Please try again later."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बहुत ज़्यादा अनुरोध। कृपया बाद में पुनः प्रयास करें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ತುಂಬಾ ವಿನಂತಿಗಳು. ದಯವಿಟ್ಟು ನಂತರ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വളരെയധികം അഭ്യർത്ഥനകൾ. ദയവായി പിന്നീട് ശ്രമിക്കുക."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அதிகமான கோரிக்கைகள். பிறகு மீண்டும் முயற்சிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చాలా ఎక్కువ అభ్యర్థనలు. దయచేసి తర్వాత మళ్లీ ప్రయత్నించండి."
          }
        }
      }
    },
