    "Internet error, please check your internet": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Internet error, please check your internet"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इंटरनेट त्रुटि, कृपया अपना इंटरनेट जाँचें"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇಂಟರ್ನೆಟ್ ದೋಷ, ದಯವಿಟ್ಟು ನಿಮ್ಮ ಇಂಟರ್ನೆಟ್ ಪರಿಶೀಲಿಸಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇന്റർനെറ്റ് പിശക്, നിങ്ങളുടെ ഇന്റർനെറ്റ് പരിശോധിക്കുക"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இணையப் பிழை, உங்கள் இணைப்பைச் சரிபார்க்கவும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇంటర్నెట్ లోపం, దయచేసి మీ ఇంటర్నెట్‌ను తనిఖీ చేయండి"
          }
        }
      }
    },
    "Invalid or expired code. Please try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invalid or expired code. Please try again."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अमान्य या समाप्त हो चुका कोड। कृपया पुनः प्रयास करें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅಮಾನ್ಯ ಅಥವಾ ಅವಧಿ ಮುಗಿದ ಕೋಡ್. ದಯವಿಟ್ಟು ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അസാധുവായതോ കാലഹരണപ്പെട്ടതോ ആയ കോഡ്. ദയവായി വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தவறான அல்லது காலாவதியான குறியீடு. மீண்டும் முயற்சிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కోడ్ చెల్లనిది లేదా గడువు ముగిసింది. దయచేసి మళ్లీ ప్రయత్నించండి."
          }
        }
      }
    },
    "Invalid request. Please try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invalid request. Please try again."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अमान्य अनुरोध। कृपया पुनः प्रयास करें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅಮಾನ್ಯ ವಿನಂತಿ. ದಯವಿಟ್ಟು ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അസാധുവായ അഭ്യർത്ഥന. ദയവായി വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தவறான கோரிக்கை. மீண்டும் முயற்சிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చెల్లని అభ్యర్థన. దయచేసి మళ్లీ ప్రయత్నించండి."
          }
        }
      }
    },
    "Invitation accepted.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitation accepted."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निमंत्रण स्वीकार किया गया।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆಹ್ವಾನ ಸ್ವೀಕರಿಸಲಾಗಿದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
