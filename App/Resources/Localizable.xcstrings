    "How can I build stronger relationships?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How can I build stronger relationships?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैं मज़बूत रिश्ते कैसे बना सकता हूँ?"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಾನು ಬಲವಾದ ಸಂಬಂಧಗಳನ್ನು ಹೇಗೆ ಕಟ್ಟಿಕೊಳ್ಳಬಹುದು?"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എനിക്ക് എങ്ങനെ ശക്തമായ ബന്ധങ്ങൾ കെട്ടിപ്പടുക്കാം?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வலுவான உறவுகளை நான் எப்படிக் கட்டியெழுப்பலாம்?"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నేను బలమైన సంబంధాలను ఎలా నిర్మించుకోవాలి?"
          }
        }
      }
    },
    "How do I break bad habits?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How do I break bad habits?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैं बुरी आदतें कैसे छोड़ूँ?"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕೆಟ್ಟ ಅಭ್ಯಾಸಗಳನ್ನು ಹೇಗೆ ಬಿಡಲಿ?"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ദുശ്ശീലങ്ങൾ എങ്ങനെ ഉപേക്ഷിക്കാം?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தீய பழக்கங்களிலிருந்து நான் எப்படி விடுபடுவது?"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చెడు అలవాట్లను ఎలా మానుకోవాలి?"
          }
        }
      }
    },
    "How do I deal with failure?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How do I deal with failure?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैं असफलता का सामना कैसे करूँ?"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ವೈಫಲ್ಯವನ್ನು ಹೇಗೆ ಎದುರಿಸಲಿ?"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പരാജയത്തെ എങ്ങനെ നേരിടാം?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தோல்வியை நான் எப்படிச் சமாளிப்பது?"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వైఫల్యాన్ని ఎలా ఎదుర్కోవాలి?"
          }
        }
      }
    },
    "How do I find peace in a busy life?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How do I find peace in a busy life?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "व्यस्त जीवन में मुझे शांति कैसे मिले?"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಗಡಿಬಿಡಿಯ ಜೀವನದಲ್ಲಿ ಶಾಂತಿಯನ್ನು ಹೇಗೆ ಕಂಡುಕೊಳ್ಳಲಿ?"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "തിരക്കേറിയ ജീവിതത്തിൽ എങ്ങനെ സമാധാനം കണ്ടെത്താം?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பரபரப்பான வாழ்க்கையில் சமாதானத்தை எப்படிக் காண்பது?"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "బిజీ జీవితంలో సమాధానాన్ని ఎలా పొందాలి?"
          }
        }
      }
    },
    "How do I find purpose in life?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How do I find purpose in life?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैं जीवन का उद्देश्य कैसे पाऊँ?"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಜೀವನದ ಉದ್ದೇಶವನ್ನು ಹೇಗೆ ಕಂಡುಕೊಳ್ಳಲಿ?"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ജീവിതത്തിന്റെ ലക്ഷ്യം എങ്ങനെ കണ്ടെത്താം?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வாழ்க்கையின் நோக்கத்தை எப்படிக் கண்டுபிடிப்பது?"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "జీవితంలో ఉద్దేశ్యాన్ని ఎలా కనుగొనాలి?"
          }
        }
      }
    },
    "How do I forgive someone who hurt me?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How do I forgive someone who hurt me?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जिसने मुझे ठेस पहुँचाई, उसे मैं कैसे क्षमा करूँ?"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನನ್ನನ್ನು ನೋಯಿಸಿದವರನ್ನು ಹೇಗೆ ಕ್ಷಮಿಸಲಿ?"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എന്നെ വേദനിപ്പിച്ചവരോട് എങ്ങനെ ക്ഷമിക്കാം?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "என்னைக் காயப்படுத்தியவரை நான் எப்படி மன்னிப்பது?"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నన్ను బాధపెట్టిన వారిని ఎలా క్షమించాలి?"
          }
        }
      }
    },
    "How do I grow closer to God?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How do I grow closer to God?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैं परमेश्वर के और निकट कैसे आऊँ?"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ದೇವರಿಗೆ ಹೇಗೆ ಹತ್ತಿರವಾಗಲಿ?"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ദൈവത്തോട് എങ്ങനെ കൂടുതൽ അടുക്കാം?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தேவனுடன் நான் எப்படி நெருங்கி வளர்வது?"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "దేవునికి మరింత దగ్గరగా ఎలా ఎదగాలి?"
          }
        }
      }
    },
    "How do I know God’s plan for my life?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How do I know God’s plan for my life?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैं अपने जीवन के लिए परमेश्वर की योजना कैसे जानूँ?"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನನ್ನ ಜೀವನದ ಬಗ್ಗೆ ದೇವರ ಯೋಜನೆಯನ್ನು ಹೇಗೆ ತಿಳಿಯಲಿ?"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എന്റെ ജീവിതത്തിനായുള്ള ദൈവത്തിന്റെ പദ്ധതി എങ്ങനെ അറിയാം?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "என் வாழ்க்கைக்கான தேவனின் திட்டத்தை எப்படி அறிவது?"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నా జీవితం కోసం దేవుని ప్రణాళికను ఎలా తెలుసుకోవాలి?"
          }
        }
      }
    },
    "How do I make the right decision?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How do I make the right decision?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैं सही निर्णय कैसे लूँ?"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸರಿಯಾದ ನಿರ್ಧಾರವನ್ನು ಹೇಗೆ ತೆಗೆದುಕೊಳ್ಳಲಿ?"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ശരിയായ തീരുമാനം എങ്ങനെ എടുക്കാം?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சரியான முடிவை நான் எப்படி எடுப்பது?"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సరైన నిర్ణయం ఎలా తీసుకోవాలి?"
          }
        }
      }
    },
    "How do I stop overthinking?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How do I stop overthinking?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैं ज़रूरत से ज़्यादा सोचना कैसे बंद करूँ?"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅತಿಯಾಗಿ ಯೋಚಿಸುವುದನ್ನು ಹೇಗೆ ನಿಲ್ಲಿಸಲಿ?"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അമിതമായി ചിന്തിക്കുന്നത് എങ്ങനെ നിർത്താം?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அதிகமாகச் சிந்திப்பதை நான் எப்படி நிறுத்துவது?"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అతిగా ఆలోచించడాన్ని ఎలా ఆపాలి?"
          }
        }
      }
    },
    "How do I trust God during difficult times?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How do I trust God during difficult times?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कठिन समय में मैं परमेश्वर पर भरोसा कैसे रखूँ?"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕಷ್ಟದ ಸಮಯದಲ್ಲಿ ದೇವರನ್ನು ಹೇಗೆ ನಂಬಲಿ?"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ബുദ്ധിമുട്ടുള്ള സമയങ്ങളിൽ ദൈവത്തെ എങ്ങനെ വിശ്വസിക്കാം?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கடினமான காலங்களில் தேவனை எப்படி நம்புவது?"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కష్ట సమయాల్లో దేవుణ్ణి ఎలా నమ్మాలి?"
          }
        }
      }
    },
    "I am reading %@ in the %@ Bible.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I am reading %@ in the %@ Bible."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैं %@ बाइबिल में %@ पढ़ रहा हूँ।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಾನು %@ ಬೈಬಲ್‌ನಲ್ಲಿ %@ ಓದುತ್ತಿದ್ದೇನೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഞാൻ %@ വായിക്കുന്നു (%@ ബൈബിൾ)."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நான் %@ பைபிளில் %@ வாசிக்கிறேன்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నేను %@ బైబిల్‌లో %@ చదువుతున్నాను."
          }
        }
      }
    },
    "I selected: \"%@\"": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I selected: \"%@\""
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैंने चुना: \"%@\""
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಾನು ಆರಿಸಿದ್ದು: \"%@\""
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഞാൻ തിരഞ്ഞെടുത്തത്: \"%@\""
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நான் தேர்ந்தெடுத்தது: \"%@\""
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
