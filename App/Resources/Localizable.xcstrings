    "Search by reference, book, or words": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search by reference, book, or words"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संदर्भ, पुस्तक या शब्दों से खोजें"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಉಲ್ಲೇಖ, ಪುಸ್ತಕ ಅಥವಾ ಪದಗಳಿಂದ ಹುಡುಕಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "റഫറൻസ്, പുസ്തകം, അല്ലെങ്കിൽ വാക്കുകൾ ഉപയോഗിച്ച് തിരയുക"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "குறிப்பு, புத்தகம் அல்லது சொற்களால் தேடுங்கள்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రిఫరెన్స్, పుస్తకం లేదా పదాలతో శోధించండి"
          }
        }
      }
    },
    "Search by voice": {
      "extractionState": "manual",
      "localizations": {
