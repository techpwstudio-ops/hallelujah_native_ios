    "One verse each day, in your Bible language.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One verse each day, in your Bible language."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर दिन एक वचन, आपकी बाइबिल की भाषा में।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಬೈಬಲ್ ಭಾಷೆಯಲ್ಲಿ ಪ್ರತಿದಿನ ಒಂದು ವಚನ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ദിവസവും ഒരു വചനം, നിങ്ങളുടെ ബൈബിൾ ഭാഷയിൽ."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தினமும் ஒரு வசனம், உங்கள் பைபிள் மொழியில்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రతి రోజు ఒక వచనం, మీ బైబిల్ భాషలో."
          }
        }
      }
    },
