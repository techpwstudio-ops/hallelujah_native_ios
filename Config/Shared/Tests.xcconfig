// Tests.xcconfig — unit test target (Swift Testing + XCTest).

PRODUCT_NAME = $(TARGET_NAME)
PRODUCT_BUNDLE_IDENTIFIER = $(APP_BUNDLE_ID_BASE)$(APP_BUNDLE_ID_SUFFIX).tests
GENERATE_INFOPLIST_FILE = YES

// Hosted tests: the suite runs inside the app process so it can reach
// internal types via @testable import.
TEST_HOST = $(BUILT_PRODUCTS_DIR)/$(APP_PRODUCT_NAME).app/$(BUNDLE_EXECUTABLE_FOLDER_PATH)/$(APP_PRODUCT_NAME)
BUNDLE_LOADER = $(TEST_HOST)

LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks @loader_path/Frameworks
EXCLUDED_SOURCE_FILE_NAMES = $(inherited) *.md .gitkeep
