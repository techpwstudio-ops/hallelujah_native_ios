      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap on a verse to add your first note"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना पहला नोट जोड़ने के लिए किसी वचन पर टैप करें"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಮೊದಲ ಟಿಪ್ಪಣಿ ಸೇರಿಸಲು ವಚನವನ್ನು ಟ್ಯಾಪ್ ಮಾಡಿ"
