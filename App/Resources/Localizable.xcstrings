    "Upgrade to Family": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upgrade to Family"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ैमिली में अपग्रेड करें"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕುಟುಂಬ ಯೋಜನೆಗೆ ಅಪ್‌ಗ್ರೇಡ್ ಮಾಡಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Family-യിലേക്ക് അപ്ഗ്രേഡ് ചെയ്യുക"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Family-க்கு மேம்படுத்து"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Familyకి అప్‌గ్రేడ్ చేయండి"
          }
        }
      }
    },
    "Upgrade to Premium for ad-free worship, high-quality audio, and offline listening.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upgrade to Premium for ad-free worship, high-quality audio, and offline listening."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विज्ञापन-मुक्त आराधना, उच्च गुणवत्ता वाले ऑडियो और ऑफ़लाइन सुनने के लिए Premium में अपग्रेड करें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಜಾಹೀರಾತು ಇಲ್ಲದ ಆರಾಧನೆ, ಉತ್ತಮ ಗುಣಮಟ್ಟದ ಆಡಿಯೋ ಮತ್ತು ಆಫ್‌ಲೈನ್ ಆಲಿಸುವಿಕೆಗಾಗಿ Premium ಗೆ ಅಪ್‌ಗ್ರೇಡ್ ಮಾಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പരസ്യമില്ലാത്ത ആരാധന, ഉയർന്ന നിലവാരമുള്ള ഓഡിയോ, ഓഫ്‌ലൈൻ ശ്രവണം എന്നിവയ്ക്കായി Premium-ലേക്ക് അപ്ഗ്രേഡ് ചെയ്യുക."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "விளம்பரமில்லா ஆராதனை, உயர்தர ஆடியோ மற்றும் ஆஃப்லைன் கேட்டலுக்கு Premium-க்கு மேம்படுத்துங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రకటనలు లేని ఆరాధన, అధిక నాణ్యత ఆడియో, ఆఫ్‌లైన్ శ్రవణం కోసం Premiumకు అప్‌గ్రేడ్ చేయండి."
          }
        }
      }
    },
    "Verify OTP & Continue": {
      "extractionState": "manual",
      "localizations": {
