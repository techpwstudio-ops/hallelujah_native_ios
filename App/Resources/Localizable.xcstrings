    "Enter a valid email address, or a mobile number including its country code.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a valid email address, or a mobile number including its country code."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मान्य ईमेल पता या देश कोड सहित मोबाइल नंबर दर्ज करें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮಾನ್ಯ ಇಮೇಲ್ ವಿಳಾಸ ಅಥವಾ ದೇಶದ ಕೋಡ್ ಸಹಿತ ಮೊಬೈಲ್ ಸಂಖ್ಯೆಯನ್ನು ನಮೂದಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സാധുവായ ഇമെയിൽ വിലാസമോ രാജ്യ കോഡ് ഉൾപ്പെടെയുള്ള മൊബൈൽ നമ്പറോ നൽകുക."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சரியான மின்னஞ்சல் முகவரியை அல்லது நாட்டுக் குறியீட்டுடன் மொபைல் எண்ணை உள்ளிடவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
