        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कृपया कारण दर्ज करें और पुनः प्रयास करें"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ದಯವಿಟ್ಟು ಕಾರಣವನ್ನು ನಮೂದಿಸಿ ಮತ್ತು ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ"
