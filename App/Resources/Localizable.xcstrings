      }
    },
    "Please choose one of the listed tip amounts.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please choose one of the listed tip amounts."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कृपया सूची में से कोई एक टिप राशि चुनें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ದಯವಿಟ್ಟು ಪಟ್ಟಿ ಮಾಡಿದ ಟಿಪ್ ಮೊತ್ತಗಳಲ್ಲಿ ಒಂದನ್ನು ಆರಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പട്ടികയിലുള്ള ടിപ്പ് തുകകളിൽ ഒന്ന് തിരഞ്ഞെടുക്കുക."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பட்டியலிடப்பட்ட அன்பளிப்புத் தொகைகளில் ஒன்றைத் தேர்ந்தெடுக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "దయచేసి జాబితాలోని టిప్ మొత్తాలలో ఒకదాన్ని ఎంచుకోండి."
          }
        }
      }
    },
    "Please choose valid date of birth, minimum 13 year old": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please choose valid date of birth, minimum 13 year old"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कृपया मान्य जन्म तिथि चुनें, न्यूनतम आयु 13 वर्ष"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ದಯವಿಟ್ಟು ಮಾನ್ಯ ಜನ್ಮ ದಿನಾಂಕವನ್ನು ಆರಿಸಿ, ಕನಿಷ್ಠ 13 ವರ್ಷ ವಯಸ್ಸು"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സാധുവായ ജനനത്തീയതി തിരഞ്ഞെടുക്കുക, കുറഞ്ഞത് 13 വയസ്സ്"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சரியான பிறந்த தேதியைத் தேர்ந்தெடுக்கவும், குறைந்தபட்சம் 13 வயது"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "దయచేసి చెల్లుబాటు అయ్యే పుట్టిన తేదీని ఎంచుకోండి, కనీసం 13 సంవత్సరాలు"
          }
        }
      }
    },
    "Please enter a playlist name and try again!": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please enter a playlist name and try again!"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कृपया प्लेलिस्ट का नाम दर्ज करें और पुनः प्रयास करें!"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ದಯವಿಟ್ಟು ಪ್ಲೇಲಿಸ್ಟ್ ಹೆಸರನ್ನು ನಮೂದಿಸಿ ಮತ್ತು ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ!"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പ്ലേലിസ്റ്റിന്റെ പേര് നൽകി വീണ്ടും ശ്രമിക്കുക!"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பிளேலிஸ்ட் பெயரை உள்ளிட்டு மீண்டும் முயற்சிக்கவும்!"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "దయచేసి ప్లేలిస్ట్ పేరును నమోదు చేసి మళ్లీ ప్రయత్నించండి!"
          }
        }
      }
    },
    "Please enter a reason and try again": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please enter a reason and try again"
