          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इंटरनेट कनेक्शन नहीं है"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇಂಟರ್ನೆಟ್ ಸಂಪರ್ಕವಿಲ್ಲ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇന്റർനെറ്റ് കണക്ഷൻ ഇല്ല"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இணைய இணைப்பு இல்லை"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇంటర్నెట్ కనెక్షన్ లేదు"
          }
        }
      }
    },
    "No internet connection. Please check your connection and try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No internet connection. Please check your connection and try again."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इंटरनेट कनेक्शन नहीं है। कृपया अपना कनेक्शन जाँचें और पुनः प्रयास करें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇಂಟರ್ನೆಟ್ ಸಂಪರ್ಕವಿಲ್ಲ. ದಯವಿಟ್ಟು ನಿಮ್ಮ ಸಂಪರ್ಕವನ್ನು ಪರಿಶೀಲಿಸಿ ಮತ್ತು ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇന്റർനെറ്റ് കണക്ഷൻ ഇല്ല. കണക്ഷൻ പരിശോധിച്ച് വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இணைய இணைப்பு இல்லை. உங்கள் இணைப்பைச் சரிபார்த்து மீண்டும் முயற்சிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇంటర్నెట్ కనెక్షన్ లేదు. దయచేసి మీ కనెక్షన్‌ను తనిఖీ చేసి మళ్లీ ప్రయత్నించండి."
          }
        }
      }
    },
    "No internet connection. Please check your network.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No internet connection. Please check your network."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इंटरनेट कनेक्शन नहीं है। कृपया अपना नेटवर्क जाँचें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇಂಟರ್ನೆಟ್ ಸಂಪರ್ಕವಿಲ್ಲ. ದಯವಿಟ್ಟು ನಿಮ್ಮ ನೆಟ್‌ವರ್ಕ್ ಪರಿಶೀಲಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇന്റർനെറ്റ് കണക്ഷൻ ഇല്ല. നിങ്ങളുടെ നെറ്റ്‌വർക്ക് പരിശോധിക്കുക."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இணைய இணைப்பு இல்லை. உங்கள் நெட்வொர்க்கைச் சரிபார்க்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇంటర్నెట్ కనెక్షన్ లేదు. దయచేసి మీ నెట్‌వర్క్‌ను తనిఖీ చేయండి."
          }
        }
      }
    },
