    "Please verify your identity to continue": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please verify your identity to continue"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जारी रखने के लिए कृपया अपनी पहचान सत्यापित करें"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮುಂದುವರಿಯಲು ದಯವಿಟ್ಟು ನಿಮ್ಮ ಗುರುತನ್ನು ಪರಿಶೀಲಿಸಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "തുടരാൻ നിങ്ങളുടെ ഐഡന്റിറ്റി സ്ഥിരീകരിക്കുക"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தொடர உங்கள் அடையாளத்தைச் சரிபார்க்கவும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కొనసాగించడానికి దయచేసి మీ గుర్తింపును ధృవీకరించండి"
          }
        }
      }
    },
    "Please wait before requesting another code.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please wait before requesting another code."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दूसरा कोड माँगने से पहले कृपया प्रतीक्षा करें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮತ್ತೊಂದು ಕೋಡ್ ವಿನಂತಿಸುವ ಮೊದಲು ದಯವಿಟ್ಟು ಕಾಯಿರಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മറ്റൊരു കോഡ് ആവശ്യപ്പെടുന്നതിന് മുമ്പ് ദയവായി കാത്തിരിക്കുക."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மற்றொரு குறியீட்டைக் கோருவதற்கு முன் காத்திருக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మరో కోడ్ అభ్యర్థించే ముందు దయచేసి వేచి ఉండండి."
          }
        }
      }
    },
    "Please wait while we accepting your invite.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please wait while we accepting your invite."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कृपया प्रतीक्षा करें, हम आपका निमंत्रण स्वीकार कर रहे हैं।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಆಹ್ವಾನವನ್ನು ಸ್ವೀಕರಿಸುವವರೆಗೆ ದಯವಿಟ್ಟು ಕಾಯಿರಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ക്ഷണം സ്വീകരിക്കുന്നതുവരെ ദയവായി കാത്തിരിക്കുക."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் அழைப்பை ஏற்கும் வரை காத்திருக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మేము మీ ఆహ్వానాన్ని అంగీకరిస్తున్నాం, దయచేసి వేచి ఉండండి."
          }
        }
      }
    },
    "Please wait while we decline your invite.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please wait while we decline your invite."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कृपया प्रतीक्षा करें, हम आपका निमंत्रण अस्वीकार कर रहे हैं।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಆಹ್ವಾನವನ್ನು ನಿರಾಕರಿಸುವವರೆಗೆ ದಯವಿಟ್ಟು ಕಾಯಿರಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ക്ഷണം നിരസിക്കുന്നതുവരെ ദയവായി കാത്തിരിക്കുക."
          }
        },
        "ta": {
