    "If switched on, we will download content only with a Wi-Fi network": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If switched on, we will download content only with a Wi-Fi network"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चालू होने पर, सामग्री केवल Wi-Fi नेटवर्क पर डाउनलोड होगी"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆನ್ ಮಾಡಿದರೆ, Wi-Fi ನೆಟ್‌ವರ್ಕ್‌ನಲ್ಲಿ ಮಾತ್ರ ವಿಷಯವನ್ನು ಡೌನ್‌ಲೋಡ್ ಮಾಡಲಾಗುತ್ತದೆ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഓൺ ചെയ്താൽ, Wi-Fi നെറ്റ്‌വർക്കിൽ മാത്രമേ ഉള്ളടക്കം ഡൗൺലോഡ് ചെയ്യൂ"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இயக்கப்பட்டால், Wi-Fi நெட்வொர்க்கில் மட்டுமே உள்ளடக்கத்தைப் பதிவிறக்குவோம்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆన్ చేస్తే, Wi-Fi నెట్‌వర్క్‌తో మాత్రమే కంటెంట్‌ను డౌన్‌లోడ్ చేస్తాం"
          }
        }
      }
    },
    "Image + verse and app link": {
      "extractionState": "manual",
      "localizations": {
        "en": {
