          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಚಾಟ್ ಪ್ರಾರಂಭಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ചാറ്റ് ആരംഭിക്കാനായില്ല"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த அரட்டையைத் தொடங்க முடியவில்லை"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ చాట్‌ను ప్రారంభించలేకపోయాం"
          }
        }
      }
    },
    "Couldn’t create the image. Please try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t create the image. Please try again."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चित्र नहीं बन सका। कृपया पुनः प्रयास करें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಚಿತ್ರ ರಚಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ. ದಯವಿಟ್ಟು ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ചിത്രം സൃഷ്ടിക്കാനായില്ല. ദയവായി വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "படத்தை உருவாக்க முடியவில்லை. மீண்டும் முயற்சிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చిత్రాన్ని సృష్టించలేకపోయాం. దయచేసి మళ్లీ ప్రయత్నించండి."
          }
        }
      }
    },
    "Couldn’t save the image. Please try again.": {
