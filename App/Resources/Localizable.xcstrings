    "Sleep timer ended. Time to rest": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep timer ended. Time to rest"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्लीप टाइमर समाप्त। अब विश्राम का समय"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ಲೀಪ್ ಟೈಮರ್ ಮುಗಿಯಿತು. ವಿಶ್ರಾಂತಿಯ ಸಮಯ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്ലീപ് ടൈമർ അവസാനിച്ചു. വിശ്രമിക്കാൻ സമയമായി"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உறக்க டைமர் முடிந்தது. ஓய்வெடுக்க நேரம்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "స్లీప్ టైమర్ ముగిసింది. విశ్రాంతి తీసుకునే సమయం"
          }
        }
      }
    },
    "Sleep timer set for %lld minutes": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep timer set for %lld minutes"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्लीप टाइमर %lld मिनट के लिए सेट किया गया"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ಲೀಪ್ ಟೈಮರ್ %lld ನಿಮಿಷಗಳಿಗೆ ಹೊಂದಿಸಲಾಗಿದೆ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്ലീപ് ടൈമർ %lld മിനിറ്റിന് സജ്ജമാക്കി"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உறக்க டைமர் %lld நிமிடங்களுக்கு அமைக்கப்பட்டது"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "స్లీప్ టైమర్ %lld నిమిషాలకు సెట్ చేయబడింది"
          }
        }
      }
    },
    "Sleep timer turned off": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep timer turned off"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्लीप टाइमर बंद किया गया"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ಲೀಪ್ ಟೈಮರ್ ಆಫ್ ಮಾಡಲಾಗಿದೆ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്ലീപ് ടൈമർ ഓഫ് ചെയ്തു"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உறக்க டைமர் அணைக்கப்பட்டது"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "స్లీప్ టైమర్ ఆఫ్ చేయబడింది"
          }
        }
      }
    },
    "Something went wrong": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ गड़बड़ हो गई"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಏನೋ ತಪ್ಪಾಗಿದೆ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എന്തോ കുഴപ്പം സംഭവിച്ചു"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஏதோ தவறு நேர்ந்தது"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఏదో తప్పు జరిగింది"
          }
        }
      }
    },
    "Something went wrong on our end. Please try again later.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong on our end. Please try again later."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हमारी ओर से कुछ गड़बड़ हो गई। कृपया बाद में पुनः प्रयास करें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಮ್ಮ ಕಡೆಯಿಂದ ಏನೋ ತಪ್ಪಾಗಿದೆ. ದಯವಿಟ್ಟು ನಂತರ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഞങ്ങളുടെ ഭാഗത്ത് എന്തോ കുഴപ്പം സംഭവിച്ചു. ദയവായി പിന്നീട് വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எங்கள் பக்கத்தில் ஏதோ தவறு நேர்ந்தது. பிறகு மீண்டும் முயற்சிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మా వైపు ఏదో తప్పు జరిగింది. దయచేసి తర్వాత మళ్లీ ప్రయత్నించండి."
          }
        }
      }
    },
    "Something went wrong please check your network": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong please check your network"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ गड़बड़ हो गई, कृपया अपना नेटवर्क जाँचें"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಏನೋ ತಪ್ಪಾಗಿದೆ, ದಯವಿಟ್ಟು ನಿಮ್ಮ ನೆಟ್‌ವರ್ಕ್ ಪರಿಶೀಲಿಸಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എന്തോ കുഴപ്പം സംഭവിച്ചു, നിങ്ങളുടെ നെറ്റ്‌വർക്ക് പരിശോധിക്കുക"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஏதோ தவறு நேர்ந்தது, உங்கள் நெட்வொர்க்கைச் சரிபார்க்கவும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఏదో తప్పు జరిగింది, దయచేసి మీ నెట్‌వర్క్‌ను తనిఖీ చేయండి"
          }
        }
      }
    },
    "Something went wrong, please check your network and try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong, please check your network and try again."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ गड़बड़ हो गई, कृपया अपना नेटवर्क जाँचें और पुनः प्रयास करें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಏನೋ ತಪ್ಪಾಗಿದೆ, ದಯವಿಟ್ಟು ನಿಮ್ಮ ನೆಟ್‌ವರ್ಕ್ ಪರಿಶೀಲಿಸಿ ಮತ್ತು ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എന്തോ കുഴപ്പം സംഭവിച്ചു, നെറ്റ്‌വർക്ക് പരിശോധിച്ച് വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஏதோ தவறு நேர்ந்தது, உங்கள் நெட்வொர்க்கைச் சரிபார்த்து மீண்டும் முயற்சிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఏదో తప్పు జరిగింది, దయచేసి మీ నెట్‌వర్క్‌ను తనిఖీ చేసి మళ్లీ ప్రయత్నించండి."
