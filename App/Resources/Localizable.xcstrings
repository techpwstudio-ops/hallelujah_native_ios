    "Could not create a share link": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not create a share link"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शेयर लिंक नहीं बन सका"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಹಂಚಿಕೆ ಲಿಂಕ್ ರಚಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഷെയർ ലിങ്ക് സൃഷ്ടിക്കാനായില്ല"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பகிர்வு இணைப்பை உருவாக்க முடியவில்லை"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "షేర్ లింక్‌ను సృష్టించలేకపోయాం"
          }
        }
      }
    },
    "Could not open the microphone: %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not open the microphone: %@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "माइक्रोफ़ोन नहीं खुल सका: %@"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮೈಕ್ರೊಫೋನ್ ತೆರೆಯಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ: %@"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മൈക്രോഫോൺ തുറക്കാനായില്ല: %@"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மைக்ரோஃபோனைத் திறக்க முடியவில்லை: %@"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మైక్రోఫోన్‌ను తెరవలేకపోయాం: %@"
          }
        }
      }
    },
    "Could not reach the voice service.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not reach the voice service."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वॉइस सेवा से संपर्क नहीं हो सका।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಧ್ವನಿ ಸೇವೆಯನ್ನು ತಲುಪಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വോയ്സ് സേവനത്തിൽ എത്താനായില്ല."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "குரல் சேவையை அடைய முடியவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వాయిస్ సేవను చేరుకోలేకపోయాం."
          }
        }
      }
    },
    "Could not resume audio after the interruption.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not resume audio after the interruption."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बाधा के बाद ऑडियो फिर शुरू नहीं हो सका।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅಡಚಣೆಯ ನಂತರ ಆಡಿಯೋ ಮುಂದುವರಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "തടസ്സത്തിന് ശേഷം ഓഡിയോ പുനരാരംഭിക്കാനായില്ല."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தடைக்குப் பிறகு ஆடியோவைத் தொடர முடியவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అంతరాయం తర్వాత ఆడియోను కొనసాగించలేకపోయాం."
          }
        }
      }
    },
    "Could not start the audio engine: %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not start the audio engine: %@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑडियो इंजन शुरू नहीं हो सका: %@"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆಡಿಯೋ ಎಂಜಿನ್ ಪ್ರಾರಂಭಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ: %@"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഓഡിയോ എഞ്ചിൻ ആരംഭിക്കാനായില്ല: %@"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஆடியோ இயந்திரத்தைத் தொடங்க முடியவில்லை: %@"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆడియో ఇంజిన్‌ను ప్రారంభించలేకపోయాం: %@"
          }
        }
      }
    },
    "Could not start the conversation.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not start the conversation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बातचीत शुरू नहीं हो सकी।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಂಭಾಷಣೆ ಪ್ರಾರಂಭಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സംഭാഷണം ആരംഭിക്കാനായില്ല."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உரையாடலைத் தொடங்க முடியவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సంభాషణను ప్రారంభించలేకపోయాం."
          }
        }
      }
    },
    "Could not update your library, please try again": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not update your library, please try again"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी लाइब्रेरी अपडेट नहीं हो सकी, कृपया पुनः प्रयास करें"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಲೈಬ್ರರಿ ನವೀಕರಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ, ದಯವಿಟ್ಟು ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ലൈബ്രറി അപ്ഡേറ്റ് ചെയ്യാനായില്ല, വീണ്ടും ശ്രമിക്കുക"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் நூலகத்தைப் புதுப்பிக்க முடியவில்லை, மீண்டும் முயற்சிக்கவும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ లైబ్రరీని అప్‌డేట్ చేయలేకపోయాం, దయచేసి మళ్లీ ప్రయత్నించండి"
          }
        }
      }
    },
    "Couldn't create share link": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't create share link"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शेयर लिंक नहीं बन सका"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಹಂಚಿಕೆ ಲಿಂಕ್ ರಚಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഷെയർ ലിങ്ക് സൃഷ്ടിക്കാനായില്ല"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பகிர்வு இணைப்பை உருவாக்க முடியவில்லை"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "షేర్ లింక్‌ను సృష్టించలేకపోయాం"
          }
        }
      }
    },
    "Couldn't create the image. Your verse is safe — try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't create the image. Your verse is safe — try again."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चित्र नहीं बन सका। आपका वचन सुरक्षित है — पुनः प्रयास करें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಚಿತ್ರ ರಚಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ. ನಿಮ್ಮ ವಚನ ಸುರಕ್ಷಿತವಾಗಿದೆ — ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ചിത്രം സൃഷ്ടിക്കാനായില്ല. നിങ്ങളുടെ വചനം സുരക്ഷിതമാണ് — വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "படத்தை உருவாக்க முடியவில்லை. உங்கள் வசனம் பாதுகாப்பாக உள்ளது — மீண்டும் முயற்சிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చిత్రాన్ని సృష్టించలేకపోయాం. మీ వచనం భద్రంగా ఉంది — మళ్లీ ప్రయత్నించండి."
          }
        }
      }
    },
    "Couldn't delete this conversation. Please try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't delete this conversation. Please try again."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह बातचीत हटाई नहीं जा सकी। कृपया पुनः प्रयास करें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಸಂಭಾಷಣೆಯನ್ನು ಅಳಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ. ದಯವಿಟ್ಟು ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ സംഭാഷണം ഇല്ലാതാക്കാനായില്ല. ദയവായി വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த உரையாடலை நீக்க முடியவில்லை. மீண்டும் முயற்சிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ సంభాషణను తొలగించలేకపోయాం. దయచేసి మళ్లీ ప్రయత్నించండి."
          }
        }
      }
    },
