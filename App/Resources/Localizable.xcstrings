    "In app purchase service is not available on your device please use another option for payment": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In app purchase service is not available on your device please use another option for payment"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इन-ऐप खरीद सेवा आपके डिवाइस पर उपलब्ध नहीं है, कृपया भुगतान के लिए कोई अन्य विकल्प चुनें"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆ್ಯಪ್‌ನಲ್ಲಿ ಖರೀದಿ ಸೇವೆ ನಿಮ್ಮ ಸಾಧನದಲ್ಲಿ ಲಭ್ಯವಿಲ್ಲ, ದಯವಿಟ್ಟು ಪಾವತಿಗೆ ಬೇರೆ ಆಯ್ಕೆ ಬಳಸಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇൻ-ആപ്പ് പർച്ചേസ് സേവനം നിങ്ങളുടെ ഉപകരണത്തിൽ ലഭ്യമല്ല, പേയ്‌മെന്റിന് മറ്റൊരു മാർഗം ഉപയോഗിക്കുക"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் சாதனத்தில் In-app வாங்கும் சேவை கிடைக்கவில்லை, பணம் செலுத்த வேறு வழியைப் பயன்படுத்தவும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "యాప్‌లో కొనుగోలు సేవ మీ పరికరంలో అందుబాటులో లేదు, దయచేసి చెల్లింపునకు మరో ఎంపికను ఉపయోగించండి"
          }
        }
      }
    },
    "Interactive pill": {
      "extractionState": "manual",
      "localizations": {
