    "Search failed, try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search failed, try again."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खोज विफल रही, पुनः प्रयास करें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಹುಡುಕಾಟ ವಿಫಲವಾಯಿತು, ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "തിരയൽ പരാജയപ്പെട്ടു, വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தேடல் தோல்வியடைந்தது, மீண்டும் முயற்சிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "శోధన విఫలమైంది, మళ్లీ ప్రయత్నించండి."
          }
        }
      }
    },
