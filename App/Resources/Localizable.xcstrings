    "%@ Bible downloaded": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Bible downloaded"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ बाइबिल डाउनलोड हो गई"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ಬೈಬಲ್ ಡೌನ್‌ಲೋಡ್ ಆಗಿದೆ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ബൈബിൾ ഡൗൺലോഡ് ചെയ്തു"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ பைபிள் பதிவிறக்கப்பட்டது"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ బైబిల్ డౌన్‌లోడ్ అయింది"
          }
        }
      }
    },
    "%@ Bible is saved on this device. Long press to remove it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Bible is saved on this device. Long press to remove it."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ बाइबिल इस डिवाइस पर सहेजी गई है। हटाने के लिए देर तक दबाएँ।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ಬೈಬಲ್ ಈ ಸಾಧನದಲ್ಲಿ ಉಳಿಸಲಾಗಿದೆ. ತೆಗೆದುಹಾಕಲು ದೀರ್ಘವಾಗಿ ಒತ್ತಿರಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ബൈബിൾ ഈ ഉപകരണത്തിൽ സേവ് ചെയ്തിട്ടുണ്ട്. നീക്കം ചെയ്യാൻ ദീർഘനേരം അമർത്തുക."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ பைபிள் இந்தச் சாதனத்தில் சேமிக்கப்பட்டுள்ளது. நீக்க நீண்ட நேரம் அழுத்தவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ బైబిల్ ఈ పరికరంలో సేవ్ చేయబడింది. తొలగించడానికి ఎక్కువసేపు నొక్కండి."
          }
        }
      }
    },
    "%@ Bible removed from this device.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Bible removed from this device."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ बाइबिल इस डिवाइस से हटा दी गई।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ಬೈಬಲ್ ಅನ್ನು ಈ ಸಾಧನದಿಂದ ತೆಗೆದುಹಾಕಲಾಗಿದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ബൈബിൾ ഈ ഉപകരണത്തിൽ നിന്ന് നീക്കം ചെയ്തു."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ பைபிள் இந்தச் சாதனத்திலிருந்து நீக்கப்பட்டது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ బైబిల్ ఈ పరికరం నుండి తొలగించబడింది."
          }
        }
      }
    },
